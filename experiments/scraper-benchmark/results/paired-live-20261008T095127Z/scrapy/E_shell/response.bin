<script>
function Trim(str)
   { 
    return str.replace(/(^\s*)|(\s*$)/g, ""); 
  }


function submitForm() {
      var andsen = document.all.searchform.andsen1.value;
      andsen = Trim(andsen);
      andsen = andsen.replace(/   /g, " ");
      andsen = andsen.replace(/  /g, " ");
      andsen = andsen.replace(/ /g, "*");
      document.all.searchform.searchword.value = andsen;
      if (andsen == '') {
        alert("请输入检索词");
        return false;
      }
      //document.all.searchform.submit();
    }
</script>

