    // 覆写点击分页代码的响应函数
    PageContext.PageNav.go =  function(_iPage,_maxPage){
        if(_iPage>_maxPage){
            _iPage = _maxPage;
        }
        //大于发布的总页数，跳转到动态应用
        if(_iPage > 155){
            window.location.href = top.GovSearchURL + "searPage.jsp?page=" + _iPage;
            return;
        }
        PageContext.params = {"CurrPage":_iPage};
        var sURL = "";
        if(_iPage == 1){
            sURL = m_sPageName + "." + m_sPageExt;
        }else{
            sURL = m_sPageName + "_" + (_iPage-1) + "." + m_sPageExt;
        }
        //alert("to: " + sURL);
        window.location.href = sURL;        
    };
//-->
