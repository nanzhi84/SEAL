 < aPath.length; i++){\n        if(aPath[i]){\n            result += aPath[i] + \"/\";\n        }\n    }\n    return protocol + result;\n}\n\n/**\n*获取站点的绝对地址\n*/\nfunction getPubURL(){\n    var sWebSiteURL = '../../';\n    var sCurrPageURL = window.location.href.replace(/\\/[^\\/]*$/g, \"/\");\n    return getCanonicalPath(sCurrPageURL + sWebSiteURL);\n}\n$('pubURL').value = getPubURL();\n$('trssearchform').action = \"http://www.stats.gov.cn/govsearch/simp_gov_list.jsp\";\n$('advanceSearch').href = \"http://www.stats.gov.cn/govsearch/advsearch.jsp\";\n</script></body></html>",
