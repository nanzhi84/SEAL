{
  "formats": [
    "markdown",
    "html",
    "rawHtml",
    "links"
  ],
  "headers": {
    "User-Agent": "SEAL-Benchmark/1.0 (bounded public-source evaluation)",
    "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8"
  },
  "only_main_content": true,
  "timeout": 45000,
  "max_age": 0,
  "store_in_cache": false,
  "proxy": "basic",
  "skip_tls_verification": false
}