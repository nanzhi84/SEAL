				if (data == "0") {
					if (lastAccessTime != null && ((Date.now() - lastAccessTime) < 60 * 1000 * 30)) {
						$('#sessionExpireDialog').modal('show');
						
					}
				}
				
	    	}
		});
    }
    
    
    checkSession();
    

