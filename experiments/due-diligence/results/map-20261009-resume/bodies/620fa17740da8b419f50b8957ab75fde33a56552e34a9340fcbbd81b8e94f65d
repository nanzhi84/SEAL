<script type="text/javascript">
        $(function(){
            $(".wx").mouseover(function(){
                $(".wechatcode").show();  
            })
            $(".wx").mouseout(function(){
                $(".wechatcode").hide();  
            })
            $(".wb").mouseover(function(){
                $(".webocode").show();  
            })
            $(".wb").mouseout(function(){
                $(".webocode").hide();  
            })
            $(".sjb").mouseover(function(){
                $(".iphonecode").show(); 
            })
            $(".sjb").mouseout(function(){
                $(".iphonecode").hide();  
            })
            $(".ytss").mouseover(function(){
                $(".ysscode").show();  
            })
            $(".ytss").mouseout(function(){
                $(".ysscode").hide(); 
            })
            $(".yst").mouseover(function(){
                $(".ystcode").show();  
            })
            $(".yst").mouseout(function(){
                $(".ystcode").hide();  
            })
            $(".lwlb").mouseover(function(){
                $(".lwlbcode").show(); 
            })
            $(".lwlb").mouseout(function(){
                $(".lwlbcode").hide(); 
            })
            
        })
        //mouseover  当鼠标指针位于元素上方时，会发生 mouseover 事件。
        //mouseout   当鼠标指针离开被选元素时，会发生 mouseout 事件。
        //hide();    hide() 隐藏
        //show();    show() 显示
        	function backToTop(){
            $(".cbl").stop().animate({right:-73});
            $(".cbl .fp-itm1").show();
            $(".cbl .fp-itm1").stop().animate({opacity:1});
        }
        function reShow(){
            $(".cbl").stop().animate({right:0});
            $(".cbl .fp-itm1").stop().animate({opacity:0});
            $(".cbl .fp-itm1").hide();
        }
</script>
