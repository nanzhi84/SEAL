<script>
    var swiper2 = new Swiper('.swiper-container2', {
        loop: true,
        grabCursor: true,
        paginationClickable: true,
        slidesPerView: 4,
        autoplay : 3000,
    });
    $('.arrow-left').on('click', function (e) {
        e.preventDefault()
        swiper2.swipePrev()
    })
    $('.arrow-right').on('click', function (e) {
        e.preventDefault()
        swiper2.swipeNext()
    })
</script>
