<script>
  var app = new Vue({
    el: '#app',
    data: {
      activeName:"first",
      boxoffice: {},
      boxofficenow:{}
    },
    methods:{
      format_thousand_table:function(row, column){
        var str ='';
        if(typeof row[column.property] === 'number') {str = row[column.property].toString();}else {str = row[column.property]}
        var reg = str.indexOf(".") > -1 ? /(\d)(?=(\d{3})+\.)/g : /(\d)(?=(?:\d{3})+$)/g;
        return str.replace(reg,"$1,");
      },
      format_thousand_normal:function(num){
        var str ='';
        if(typeof num === 'number') {str = num.toString();}else {str = num}
        var reg = str.indexOf(".") > -1 ? /(\d)(?=(\d{3})+\.)/g : /(\d)(?=(?:\d{3})+$)/g;
        return str.replace(reg,"$1,");
      }
    },
    mounted:function() {
      var _this=this;
      this.$nextTick(function () {
        $.ajax({
          type: "get",
          url: 'https://www.zgdypw.cn/data/searchSevenDaysBoxOffice.json?timestamp='+new Date().getTime(),
          success: function(res){
            var arr1=[];
            var arr2=[];
            for(var i=0,len=res.data.length;i<len;i++){
              arr1.push(res.data[i].totalBoxoffice);
              arr2.push(res.data[i].businessDay.substring(res.data[i].businessDay.length-5));
            }
            var options = {
              series: [{
                name: '票房（万元）',
                data: arr1
              }],
              chart: {
                height: 220,
                type: 'area',
                animations: {
                  enabled: true,
                  easing: 'linear',
                  speed: 1000,
                  animateGradually: {
                    enabled: true,
                    delay: 300
                  },
                  dynamicAnimation: {
                    enabled: true,
                    speed: 500
                  }
                }
              },
              dataLabels: {
                enabled:true,
                style: {
                  fontSize: '10px',
                  fontWeight: 'normal',
                  colors: undefined
                },
                offsetY:-7
              },
              grid: {
                borderColor: "#e5e5e5",
                strokeDashArray: 1,
                yaxis: {
                  lines: {show: true }
                },
                xaxis: {
                  lines: { show: true}
                }
              },
              markers: {
                size: 2,
              },
              fill: {
                gradient: {
                  enabled: true,
                  opacityFrom: 1,
                  opacityTo: 0.8
                }
              },
              colors:["#3380cb"],
              stroke: {
                curve: 'smooth'
              },
              xaxis: {
                type: 'string',
                categories: arr2
              },
              yaxis:{
                labels: {
                  style: {
                    colors: ["#aaa"],
                    fontSize: '10px',
                    fontWeight: 100,
                  }
                }
              }
            };

            var chart = new ApexCharts(document.querySelector("#chart"), options);
            chart.render();

            setInterval(function(){
              sevenDays();
            }, 5*60*1000);
          },
          error:function(){
          }
        })
        // 一周数据
        function sevenDays(){
          $.ajax({
            type: "get",
            url: 'https://www.zgdypw.cn/data/searchSevenDaysBoxOffice.json?timestamp='+new Date().getTime(),
            success: function(res){
              var arr1=[];
              for(var i=0,len=res.data.length;i<len;i++){
                arr1.push(res.data[i].totalBoxoffice);
              }
              chart.updateSeries([{
                data: arr1
              }]);
            },
            error:function(){
            }
          })
        }
        // 每日数据
        function boxoffice(){
          $.ajax({
            type: "get",
            url: 'https://www.zgdypw.cn/data/searchDayBoxOffice.json?timestamp='+new Date().getTime(),
            success: function(res){
              _this.boxoffice=res.data;
            },
            error:function(){
            }
          }) 
        }
        boxoffice();
        setInterval(function(){
          boxoffice();
        }, 5*60*1000);
        // 实时大盘
        function realTime(){
          $.ajax({
            type: "get",
            url: 'https://www.zgdypw.cn/data/realtimedata.json?timestamp='+new Date().getTime(),
            success: function(res){
              _this.boxofficenow=res;
            },
            error:function(){
            }
          })
        }
        realTime();
        setInterval(function(){
          realTime();
        }, 0.5*60*1000);
      });
    }
  });
</script>
