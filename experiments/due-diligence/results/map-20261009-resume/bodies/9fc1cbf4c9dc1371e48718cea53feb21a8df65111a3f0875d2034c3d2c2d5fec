              var $mainEle = S.all('.J_MainNavFirst');
              var mainPattern = $mainEle.attr('data-pattern');
              var href = location.href;
              if (href.indexOf(mainPattern) > -1) {
                  if ($mainEle.addClass) {
                      $mainEle.addClass('current');
                  }
              }
              if (href.indexOf('sf-item.taobao.com')===-1) {
                  S.DOM.style('.top-right-app', {visibility: 'visible'});
              }

              for (var i = 0; i < eles.length; i++) {
                  var $eleItem = S.all(eles[i]);
                  var matchPattern = $eleItem.attr('data-pattern');
                  if (matchPattern) {
                      matchPattern = matchPattern.split('|');
                      matchPattern.forEach((t) => {
                          if (mainPattern !== t) {
                              if (new RegExp(t).test(href)) {
                                  if ($eleItem.addClass) {
                                      $mainEle.removeClass('current');
                                      $eleItem.addClass('current');
                                  }
                                  return;
                              }
                          }
                      });
                  }
              }
