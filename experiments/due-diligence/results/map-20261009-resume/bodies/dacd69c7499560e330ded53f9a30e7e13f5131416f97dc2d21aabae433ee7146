			                $("#gwyxx_list").html(str);
									  
			            });
			        },
			        error:function(){
			            //alert("错误");
			        }
			    });
			})
	
	</script>
	<script>
		$(function () {
			$.ajax({
				url: "https://www.beijing.gov.cn/shouye/tltt/pushCommitteeNews_33256.js",
				dataType: "jsonp",
				scriptCharset: "UTF-8",
				jsonp: "pushInfoJsCallBack",
				jsonpCallback: "pushInfoJsCallBack",
				success: function (data) {
					$.each(data.data2, function (i, json) {
						if (i >= 5) {
							return false;
						}
						var l = json.title.length;
						var title = (l >= 47) ? json.title.substring(0, 45) + "..." : json.title;
						// $("#zyjs_list").append("<li><a target='_blank' title='" + json.title + "' href='" + json.link + "'>" + title + "</a></li>");
						// 填充原始元素
						$("#zyjs_list").append("<li><a target='_blank' title='" + json.title + "' href='" + json.link + "'>" + title + "</a></li>");
						// 同时填充移动端元素（如果存在）
						$("#link_zyjs_mobile .list").append("<li><a target='_blank' title='" + json.title + "' href='" + json.link + "'>" + title + "</a></li>");
					});
					$.each(data.data3, function (i, json) {
						if (i >= 5) {
							return false;
						}
						var l = json.title.length;
						var title = (l >=47) ? json.title.substring(0, 45) + "..." : json.title;
						// $("#bjyw_list").append("<li><a target='_blank' title='" + json.title + "' href='" + json.link + "'>" + title + "</a></li>");
						// 填充原始元素
						$("#bjyw_list").append("<li><a target='_blank' title='" + json.title + "' href='" + json.link + "'>" + title + "</a></li>");
						// 同时填充移动端元素（如果存在）
						$("#link_bjyw_mobile .list").append("<li><a target='_blank' title='" + json.title + "' href='" + json.link + "'>" + title + "</a></li>");
					});
				},
				error: function () {
					alert("error");
				},
			});
		});
