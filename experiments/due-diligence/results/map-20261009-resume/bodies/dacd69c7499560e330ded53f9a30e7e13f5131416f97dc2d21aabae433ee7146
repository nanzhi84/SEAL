		<script>
			$.ajax( {
			    url: '//yewu.ghzrzyw.beijing.gov.cn/gwwz/open/zxftarticle/getZxftarticleFirst',
			    type: "get",
			    scriptCharset:'UTF-8',
			    success: function(res){
			        //console.log(res.data);
			        var data = res.data;
			        var filePath = '';
			        if(data.file){
			            filePath = '//yewu.ghzrzyw.beijing.gov.cn/gwhdUploadFile/'+data.file.fileUrl;
			        }else{
			            filePath = '//yewu.ghzrzyw.beijing.gov.cn/common/plugins/images/defaultLogo.png';
			        }
			        //console.log('图片路径：' + filePath);
			        //console.log('status：' + data.status);
			        //console.log('主题：' + data.title);
			        var releaseTime = '';
			        if(data.releaseTime){
			            releaseTime = data.releaseTime.substr(0,16);
			        }
			        //console.log('时间：' + releaseTime);
			        //console.log('key：' + data.id);
			        openDetail(data.id,data.status,filePath,data.title,releaseTime);
			    }
			});

			//查看访谈详情
			function openDetail(key,status,zxftPath,zxfttitle,zxfttime){
			    var fileurl = '';
			    if(status == '1'){
			        fileurl = '//yewu.ghzrzyw.beijing.gov.cn/gwhd/zxft/ftdone.html?key='+key;
			    }else if (status == '0'){
			        fileurl = '//yewu.ghzrzyw.beijing.gov.cn/gwhd/zxft/ftdoing.html?key='+key;
			    }else{
			        return false;
			    }
					
			    var strlist = '';
			    strlist="<div style='width:100%;height:15px;'></div><a href='"+fileurl+"' class='zmhdconleft' target='_blank'><span  class='zxdtbox'><img src='"+zxftPath+"' /></span></a><br/><div style='width:100%;height:5px;'><span class='ztcon1'>主题："+zxfttitle+"</span><div style='width:100%;height:5px;'><span class='ztcon1'>时间："+zxfttime+"";
			    $('#zxft_list').html(strlist);
					
			}

		</script>
		<script>
			//国务院信息
			$(function(){
			    $.ajax({
			        url :'//www.gov.cn/pushinfo/v150203/pushinfo.jsonp',
			        dataType : "jsonp",
			        scriptCharset:'UTF-8', 
			        jsonp : "pushInfoJsonpCallBack",
