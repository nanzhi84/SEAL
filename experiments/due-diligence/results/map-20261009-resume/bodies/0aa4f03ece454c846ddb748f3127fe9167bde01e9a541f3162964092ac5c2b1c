<script>

    function showLocale() {
        var objD = new Date();
        var _date,_time;
        var yy = objD.getFullYear();
        if (yy < 1900) yy = yy + 1900;
        var MM = objD.getMonth() + 1;
        if (MM < 10) MM = '0' + MM;
        var dd = objD.getDate();
        if (dd < 10) dd = '0' + dd;
        var hh = objD.getHours();
        if (hh < 10) hh = '0' + hh;
        var mm = objD.getMinutes();
        if (mm < 10) mm = '0' + mm;
        var ss = objD.getSeconds();
        if (ss < 10) ss = '0' + ss;
        _date =  yy + '年'+ MM + '月' + dd + '日';
        _time =  hh + ':' + mm + ':' + ss;
        $("#date").html(_date);
        $("#time").html(_time);
        setTimeout("showLocale();",1000);//每隔1秒刷新一次
    }
    showLocale();

</script>
