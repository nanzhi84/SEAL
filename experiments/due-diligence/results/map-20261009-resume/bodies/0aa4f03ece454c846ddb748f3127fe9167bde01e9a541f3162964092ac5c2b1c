					setInterval(function() {
						if (stop == true) {
							return;
						}
						$("#notice").children("li").first().animate({
							"margin-top": margintop--
						}, 0, function() {
							var $li = $(this);
							if (!$li.is(":animated")) { 
								if (-margintop > $li.height()) {
									$li.css("margin-top", "0px").appendTo($("#notice"));
									margintop = 0;
								}
							}
						});
					}, 300);
					$("#notice>li").hover(function() {
						$(this).css("cursor", "pointer");
						stop = true; 
					}, function() {
						stop = false; 
