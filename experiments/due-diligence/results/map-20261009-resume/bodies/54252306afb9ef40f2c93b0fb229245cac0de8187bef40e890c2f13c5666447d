    function getTraining() {
        $.ajax({
            url: 'nsrxt/train/searchindex',
            type: 'post',
            data: {
                keyword: "",
                area: ssjg,
                type: "",
                sign: "",
                pageIndex: "1",
                listCount: "4"
            },
            dataType: 'json',
            success: function (res) {
                if (res.json.data.code === 0) {
                    return;
                }

                var dataList = res.json.data.data;
                var currentDate = new Date(res.json.nowDate.replace(/-/g,"/"));
                var bmrs;
                var jhrs;
                $('#training-info').empty();
                for (var i = 0; i < dataList.length && i < 4; i++) {
                    //判断报名状态
                    //未报名
                    dataList[i]['stateClass'] = 'signing';
                    dataList[i]['stateText'] = '我要报名';


                    // 人数已满
                    jhrs = dataList[i].jhrs || 0;
                    bmrs = dataList[i].bmrs || 0;
                    if(parseInt(jhrs) <= parseInt(bmrs)) {
                        dataList[i]['stateClass'] = 'btn-orange';
                        dataList[i]['stateText'] = '名额已满';
                    }

                    // 报名截止
                    var applyEnd = dataList[i]['bmjssj'];
                    if(applyEnd) {
                        var applyEndDate = new Date(applyEnd.replace(/-/g,"/").replace(/\.0/g,""));
                        if (currentDate > applyEndDate) {
                            dataList[i]['stateClass'] = 'btn-gray';
                            dataList[i]['stateText'] = '报名截止';
                        }
                    }

                    // 用户已登录下的状态
                    if(jQuery.inArray(dataList[i].id, userLesson) > -1) {
                        // 取消报名
                        dataList[i]['stateClass'] = 'btn-green-alter';
                        dataList[i]['stateText'] = '取消报名';
                        // 正在培训
                        var lessonStart = dataList[i]['pxkssj'];
                        if(lessonStart) {
                            var lessonStartDate = new Date(lessonStart.replace(/-/g,"/").replace(/\.0/g,""));
                            if(currentDate > lessonStartDate) {
                                dataList[i]['stateClass'] = 'btn-blue';
                                dataList[i]['stateText'] = '正在培训';
                            }
                        }
                    }
                    // 培训过期
                    var lessonEnd = dataList[i]['pxjssj'];
                    if(lessonEnd) {
                        var lessonEndDate = new Date(lessonEnd.replace(/-/g,"/").replace(/\.0/g,""));
                        if (currentDate > lessonEndDate) {
                            dataList[i]['stateClass'] = 'btn-gray';
                            dataList[i]['stateText'] = '培训过期';
                        }
                    }

                    // 时间格式
                    // 培训开始时间
                    var date = dataList[i]['pxkssj'];
                    if(date) {
                        dataList[i]['pxkssj'] = date.substring(0, date.lastIndexOf(':'));
                    }

                    var info = '<tr><td><a class="fn-text" href="nsrxt/train/detail?id=' + dataList[i].id + '" target="_blank" title="' + dataList[i].kcmc + '">' + dataList[i].kcmc + '</a></td>' +
                        '<td><span class="xcpx-pxdd" title="' + dataList[i].pxdd + '">' + dataList[i].pxdd + '</span></td>' +
                        '<td><span class="time">' + dataList[i].pxkssj + '</span></td>' +
                        // '<td><a class="sign-btn ' + dataList[i].stateClass + '" id="' + dataList[i].id + '">' + dataList[i].stateText + '</a></td>'+
                        '</tr>';

                    $('#training-info').append(info);
                }
            }
        });
    }

    //培训计划报名
    function enterForTraining(obj, lessonId) {
        // 判断是否已登录
        login_header.checkLogin(function () {
            var flag = isLogin;
            // 已登录
            if (flag) {
                $.ajax({
                    url: 'nsrxt/train/enter',
                    type: 'post',
                    data: {lessonId: lessonId},
                    dataType: 'json',
                    success: function (res) {
                        if (res.code === 0) {
                            // 异常
                            $.error(res.msg);
                            return false;
                        }

                        $.correct(res.msg);
                        $(obj).removeClass('signing');
                        $(obj).addClass('btn-green-alter');
                        $(obj).html('取消报名');
                    }
                })
            } else {
                // 未登录，显示登录弹窗
                $('.reg-login a').eq(1).click();
            }
        });
    }

    // 取消报名
    function cancelRegistration(obj, lessonId) {
        $.confirm("确定要取消本次报名?(在报名截止前可再次报名)", {okCall: function(){
                $.ajax({
                    url: 'nsrxt/train/cancel',
                    type: 'post',
                    data: {lessonId: lessonId},
                    dataType: 'json',
                    success: function (res) {
                        if(res.code === 0) {
                            // 异常
                            return false;
                        }

                        $(obj).removeClass('btn-green-alter');
                        $(obj).addClass('signing');
                        $(obj).html('我要报名');
                    }
                })
            }});
    }

