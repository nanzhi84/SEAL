    function indexSearch(that, index, sys) {
        var url = $(that).attr("url")||$(that).next().attr("url"),
            val = that.value||$(that).prev().val(),
            input = '';
        if (!val) {
            val = '';
        }
        // 跳转系统类型
        if(sys){
           if(sys == 'znzx'){
               url = syslink['znzx'];
           }else if(sys == 'csad'){
               url = syslink['csad'];
           }
        }

        if (index != 2 && index != 4) {
            val = Base64.encode(val);
            // url = url + val;
            input = '<input type="hidden" name="question" value="' + val + '">';
            if(url.indexOf("?") > 0){
                url += "&question="+ val+"&guide="+guide;
            }else{
                url += "?question="+ val+"&guide="+guide;
            }
            window.open(url);
            return;
        } else if (index == 2) {
            url = url + encodeURI(val);
        } else {
            url = url + val;
        }
        var form = $('<form action="' + url + '" target="_blank" method="post">' + input + '</form>');
        $('body').append(form);

        form.submit();
        form.remove();
    }

