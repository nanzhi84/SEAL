                            return false;
                        }
                    }
                    var key = document.getElementById("keyword").value;
                    //location.href='/search.html?searchWord=' + encodeURI(key)+'&dataTypeId='+$("#dataTypeId").val();
                    if ($("#siteId").val() == "1") {
