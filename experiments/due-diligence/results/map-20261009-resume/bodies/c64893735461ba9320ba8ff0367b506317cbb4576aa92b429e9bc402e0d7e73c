            <script>
                //回车键响应方法
                function entersearch1() {
                    var event = window.event || arguments.callee.caller.arguments[0];
                    if (event.keyCode == 13) {
                        var str = document.getElementById("keyword").value;
                        checks1(str); //搜索框点击提交的方法
                    }
                }
                //检索跳转
                function searchval1() {
                    var str = document.getElementById("keyword").value;
                    checks1(str);
                };

                function checks1(t) {
                    t = t.replace(/(^\s+)|(\s+$)/g, "");
                    if (t == "" || t == "请输入你要搜索的内容") {
                      
                        alert('请输入有效内容');
                        return false;
                    }
                    szMsg = "[#_%&'/",
                        ";:=!^]";
                    alertStr = "";
                    for (i = 1; i < szMsg.length + 1; i++) {
                        if (t.indexOf(szMsg.substring(i - 1, i)) > -1) {
                            alertStr = "请勿包含非法字符如[#_%&'/",
                                ";:=!^]";
                            layer.msg(alertStr);
                            //alert(alertStr);
