    $('.s .con .list-tab li').click(function () {
        if(!$(this).hasClass("on")){
            $(this).addClass('on').siblings().removeClass('on');
            // $('.s .mid-box .c-box .city-box>a').removeClass("on");
            // reset();
            searchlist();
        }
    })
    //点击下拉框消失
    $('.select-box .select-item li').on('click',function () {
        var value=$(this).attr('tabvalue');
        var text=$(this).html();
        if(value){
            $(this).parents('.select-box').find('span').attr('value',value).html(text);
        }else{
            $(this).parents('.select-box').find('span').attr('value','').html('全部');
        }
        $(".select-item").hide();
        return false;
    })
    var oldParams;
    //根据查询条件查询数据
    function searchlist() {
        var jglb="";
        var tscdj = '';
        var fl=$('.s .list-tab .hd li[class$="on"]').attr('tabvalue');
        if(fl=='03'){
            $('#common').hide();
            $('#special').show();
            jglb=$('.s #special .select-box span').attr('value');
        }else{
            $('#common').show();
            $('#special').hide();
            jglb=$('.s #common .select-box span').attr('value');
        }
        var info=$('#jgmc.information').val();
        var ssjg=$('.s .mid-box .c-box .city-box a[class$="on"]').attr('value');
        if (fl == '03') {
            // 当选择 未经行政登记的税务师事务所 时，查询所有数据
            jglb = '';
        } else if (fl == '00') {
            fl = '';
            tscdj = 'TSC5';
        }
        var params= {
            fl:fl,
            jglb: jglb,
            info: Base64.encode(info),
            ssjg:ssjg,
            tscdj: tscdj
        };
        if (!oldParams || params.fl !== oldParams.fl) {
            params.change = '1';
        } else {
            params.change = '0'
        }
        oldParams = params;
        _Page.pagecreate(params);
    }
    //重置
    function reset() {
        var fl=$('.s .list-tab .hd li[class$="on"]').attr('tabvalue');
        if(fl!='03'){
            $('.s #common .select-box span').attr('value','');
            $('.s #common .select-box span').html('全部');
        }
        $('#jgmc.information').val("");
    }
    //展示详情页
    function showdetail(obj){
        var bh=$(obj).attr("id");
        window.open("/sszyfw/bulletinBoard/detail?bh="+bh);
    }
    //查询分页
    var _Page= {
        pageInit: false,
        cacheOptions: {},
        cacheData: {},
        currentPage: '1',
        clickPage: function (value, totalCount) {
            if (value == '+1') {
                _Page.currentPage++;
            } else if (value == '-1') {
                _Page.currentPage--;
            } else if (value == 'first') {
                _Page.currentPage = '1';
            } else if (value == 'last') {
                if (totalCount) {
                    _Page.currentPage = Math.ceil(totalCount/15);
                } else {
                    _Page.currentPage = '1';
                }
            } else {
                _Page.currentPage = value;
            }

            _Page.cacheOptions.data.change = '0';
        },
        reload: function (param) {
            if (param) {
                if (_Page.cacheOptions.data.currentPage == '1') {
                    _Page.pageInit = false;
                }
                _Page.cacheOptions.data = param;
            }
            _Page.search(_Page.cacheOptions);
        },
        pagecreate: function (param) {
            if (param.currentPage) {
                param = $.extend({currentPage: param.currentPage}, param);
            } else {
                param = $.extend({currentPage: 1}, param);
            }

            _Page.pageInit = false;
            _Page.search({
                url: '/sszyfw/bulletinBoard/getBulletinBoardPage',
                data: param,
                callback: function (result) {
                    $(".table-list").html(result.data);
                }
            });
        },
        pagination: function (totalCount, options) {
            $(".pageinner").paging(totalCount, {
                perpage: 15,
                format: '[< nncnn >]',
                onSelect: function (currentPage) {
                    options.data.currentPage = currentPage;
                    _Page.cacheOptions = options;
                    if (_Page.pageInit) {
                        _Page.search(options);
                    }
                },
                onFormat: function (type) {
                    switch (type) {
                        case 'block': // n and c
                            if (this.value == this.page) {
                                return '<div class="pagination-page page-current" jp-role="page"><a onclick="_Page.clickPage('+this.value+');">' + this.value + '</a></div>';
                            } else {
                                return '<div class="pagination-page" jp-role="page"><a onclick="_Page.clickPage('+this.value+');">' + this.value + '</a></div>';
                            }
                        case 'next': // >
                            if (this.value == this.page) {
                                return '<div class="pagination-page unprev" jp-role="next"><a onclick="_Page.clickPage(+1);" class="page-next">下一页</a></div>';
                            } else {
                                return '<div class="pagination-page" jp-role="next"><a onclick="_Page.clickPage(+1);" class="page-next">下一页</a></div>';
                            }
                        case 'prev': // <
                            if (this.value == this.page) {
                                // 	  						return '';
                                return '<div class="pagination-page unprev" jp-role="prev"><a onclick="_Page.clickPage(-1);">上一页</a></div>';
                            } else {
                                return '<div class="pagination-page" jp-role="prev"><a onclick="_Page.clickPage(-1);">上一页</a></div>';
                            }
                        case 'first': // [
                            if (this.value == this.page) {
                                return '<div class="pagination-page unprev" jp-role="first"><a onclick="_Page.clickPage(\'first\');">首页</a></div>';
                            } else {
                                return '<div class="pagination-page" jp-role="first"><a onclick="_Page.clickPage(\'first\');">首页</a></div>';
                            }
                        case 'last': // ]
                            if (this.value == this.page) {
                                return '<div class="pagination-page unprev" jp-role="last"><a onclick="_Page.clickPage(\'last\','+totalCount+');">尾页</a></div>' +
                                    '<div class="pagination-page" jp-role="last">共<span>'+totalCount+'</span>条</div>';
                            } else {
                                return '<div class="pagination-page" jp-role="last"><a onclick="_Page.clickPage(\'last\','+totalCount+');">尾页</a></div>' +
                                    '<div class="pagination-page" jp-role="last">共<span>'+totalCount+'</span>条</div>';
                            }
                    }
                }
            });
        },
        search: function (options) {
            $.post(options.url, options.data, function (result) {
                if(result.code==0){
                    $.info(result.msg);
                    return false;
                }
                if (result.data.flag != false) {
                    $('.dialog-bg').remove();
                    var str="";
                    var list = result.data.pageSet;
                    if (list && list.length > 0) {
                        var maxCount=result.data.maxCount;
                        var fl = options.data.fl;
                        // var str = '<tr><th>机构名称</th><th width="80">法定代表人</th><th>机构地址</th><th width="90">联系电话</th></tr>';
                        var str = '<tr><th width="230">机构名称</th><th width="80">法定代表人</th><th>机构地址</th></tr>';
                        for( var i=0;i<list.length;i++){
                            if (list[i].SSLX == '03') {
                                str+='<tr>';
                            } else if (list[i].SSLX == '04') {
                                str+='<tr class="col-gray">';
                            }
                            var a = '';
                            if(fl != '03'){
                                a = '<a onclick="showdetail(this)" id="'+list[i].CODE+'" target="_blank" title="'+list[i].TITLE+'">'+list[i].TITLE+'</a>';
                            }else{
                                a = list[i].TITLE;
                            }
                            str+='<td>'+a+'</td>' +
                                '<td>'+list[i].UNITNAME+'</td>' +
                                '<td>'+list[i].CONTENT+'</td>' +
                                // '<td style="word-break:break-all;">'+list[i].ABSTRACT+'</td>' +
                                '</tr>';
                        }
                        result.data = str;
                        result.count = maxCount;
                        _Page.cacheData.maxCount = maxCount;

                        if (_Page.cacheData.newPage == '1') {
                            // 如果为新的分页，重新初始化分页插件
                            _Page.pageInit = false;
                            _Page.cacheData.newPage = '0';
                        }
                        var currentPage = $('.pagination-page.page-current a').html();
                        if (maxCount < currentPage) {
                            _Page.pageInit = false;
                        }

                        $(".pagination").show();
                        $(".default-box").hide();
                    } else {
                        // result.data = str;
                        $(".pagination").hide();
                        $(".default-box").show();
                    }
                    options.callback(result);
                } else {
                    result.count = _Page.cacheData.maxCount;
                    if($(".code-box img").length==0){
                        $.openDialog("/sszyfw/bulletinBoard/code", "请输入验证码", {"diastyle": "", "titlestyle": "", "dialogname": "code"});
                    }else{
                        $(".code-box img").attr("src",'/sszyfw/bulletinBoard/code/img?d='+Math.random());
                        $.info('验证码错误，请重试');
                    }
                }

                if (_Page.pageInit == false) {
                    _Page.pagination(result.count, options);
                    _Page.pageInit = true;
                }
            }, 'json');
        }
    };

    function searchPerson() {
        var mc = Base64.encode($('.ssrymc').val());
        var hm = Base64.encode($('.ssryhm').val());
        $.openDialog("/sszyfw/bulletinBoard/person/page?mc=" + mc + "&hm=" + hm, "查询结果", {"diastyle": "", "titlestyle": "", "dialogname": "person"});
    }

    function resetPerson() {
        $('.ssrymc').val('');
        $('.ssryhm').val('');
    }

    function searchKeyMonitored() {
        var kmmc = $('#kmmc.information').val();
        var kmjglb = $('.s #kmjg .select-box span').attr('value');
        $.openDialog("/sszyfw/bulletinBoard/keyMonitored/page?kmmc=" + kmmc + "&kmjglb=" + kmjglb, "重点监管对象查询", {"diastyle": "width: 720px; maxHeight: 800", "titlestyle": "font-size: 20px;", "dialogname": "kmbb"});
    }

    function resetKeyMonitored() {
        $('#kmmc.information').val('');
        $('.s #kmjg .select-box span').attr('value','');
        $('.s #kmjg .select-box span').html('全部');
    }
</script>

