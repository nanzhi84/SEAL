            var min = json.min;
            chart = Highcharts.chart(type_id, {
                chart: {
                    zoomType: 'x'
                },
                title: {
                    text: type+'指数数据走势图'
                },
                xAxis: {
                    type: 'datetime',
                    dateTimeLabelFormats: {
                        millisecond: '%H:%M:%S.%L',
                        second: '%H:%M:%S',
                        minute: '%H:%M',
                        hour: '%H:%M',
                        day: '%m-%d',
                        week: '%m-%d',
                        month: '%Y-%m',
                        year: '%Y'
                    }
                },
                tooltip:
                {
                    formatter: function () {
                        var d = new Date(this.x);
                        var month = (d.getMonth() + 1)<10?"0"+(d.getMonth() + 1):(d.getMonth() + 1);
                        var s = '<b>' + d.getFullYear() + '-' + month +'</b>';
                        s += '<br/><span style="color:' + this.point.series.color + '">' + this.point.series.name + ': ' +
                                this.point.y.toFixed(2) + ' </span>';
                        return s;
                    }
                }
                ,
                yAxis: {
