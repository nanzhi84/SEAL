        function getIndexNum(type) {
            $.ajax({
                type: 'post',
                url: basePath + 'loadIndexByPage.do',
                dataType: 'json',
                data: {
                    'showType': type
                },
                success: function (json) {
                    var data = json.list;
                    if (data.length > 0) {
                        if(type=='6'){
                            $("#indexNum6").text(data[0].showValue);
                        }else if(type=="7"){
                            $("#indexNum7").text(data[0].showValue);
                        }else{
                            $("#indexNum8").text(data[0].showValue);
                        }
                    }
                },// end success
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    $.messager.alert('温馨提示', '服务器繁忙，请联系管理员');
                }// end error
            });// end ajax
        }

        function setGuangGaoIsShow() {
            var flag = getCookie("isRepeat");
            if (flag == "yes") {
                var obj = document.getElementById("dingwei");
                obj.style.display = "none";
            }
        }

        function setCookie() {
            document.cookie = "isRepeat=yes";

        }

        function getCookie(name) {
            var arr, reg = new RegExp("(^| )" + name + "=([^;]*)(;|$)");
            if (arr = document.cookie.match(reg))
                return unescape(arr[2]);
            else
                return null;
        }

