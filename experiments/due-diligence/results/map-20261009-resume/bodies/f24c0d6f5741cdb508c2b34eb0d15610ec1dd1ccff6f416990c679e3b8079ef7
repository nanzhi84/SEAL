						<span style="font-size: 12.0pt; font-family: 宋体; color: #404040;">最低交易<span></span></span>
					</p>
				</td>
				<td style="border: solid windowtext 1.0pt;" width="41%">
					<p class="MsoNormal" style="text-align: left; background: white;"
						align="left">
						<span style="font-size: 12.0pt; font-family: 宋体; color: #404040;">10000</span><span
							style="font-size: 12.0pt; font-family: 宋体; color: #404040;">股起<span></span></span>
					</p>
				</td>
				<td style="border: solid windowtext 1.0pt;" width="39%">
					<p class="MsoNormal" style="text-align: left; background: white;"
						align="left">
						<span style="font-size: 12.0pt; font-family: 宋体; color: #404040;">-</span>
					</p>
				</td>
