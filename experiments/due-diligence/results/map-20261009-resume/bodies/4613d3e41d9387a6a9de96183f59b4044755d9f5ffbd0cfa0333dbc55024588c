    document.addEventListener('DOMContentLoaded', function () {
        const sideBox = document.querySelector('.sideBox');
        const closeSide = document.querySelector('#close-side');
        const closeSideExp = document.querySelector('#close-side-exp');
        const sideList = document.querySelector('.side-list');
        const threshold = 800;
        let isManuallyClosed = false; // 添加标志变量

        function handleScroll() {
            // 如果用户手动关闭了侧边栏，则不再处理滚动事件
            if (isManuallyClosed) return;

            const scrollPosition = window.scrollY || document.documentElement.scrollTop;

            if (scrollPosition < threshold) {
                sideBox.classList.add('hidden');
            } else {
                sideBox.classList.remove('hidden');
                sideBox.style.display = 'block';
            }
        }


        // 初始检查
        handleScroll();

        // 添加滚动事件监听
        window.addEventListener('scroll', handleScroll);

        // 添加点击事件监听器到 closeSide 按钮
        closeSide.addEventListener('click', function () {
            sideBox.style.width="31px";
          	 this.style.display="none";
          	 sideList.style.display="none";
            closeSideExp.style.display="flex";
            isManuallyClosed = true; // 设置标志为true表示用户手动关闭
        });
      closeSideExp.addEventListener('click', function () {
        sideBox.style.width="126px";
        closeSide.style.display="flex";
        closeSideExp.style.display="none";
        sideList.style.display="block";
      });

        // document.querySelector('#show-side').addEventListener('click', function() {
        //     isManuallyClosed = false;
        //     handleScroll();
        // });
    });
