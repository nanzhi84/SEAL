            <script type="text/javascript">
              function getJrtsList(){
                // 首页>业务日历>今日提示  查询开始
                let list = [], now2 = new Date(), yy = now2.getFullYear(), mm = now2.getMonth() + 1, dd = now2.getDate();
                mm = (mm < 10 ? "0" : "") + mm;
                dd = (dd < 10 ? "0" : "") + dd;

                //************ 查询获取今日提示数据 开始 ***********
                $.ajax({
                  type: "post",
                  url: "/cbiw/GetBase/findCJRTS",
                  data: {
                    flag: yy + '-' + mm + '-' + dd,
                    sType: ''
                  },
                  async: false,
                  dataType: "json",
                  success: function (res) {
                    if (res && res.length > 0) {
                      for (let i = 0, vl = res.length; i < vl; i++) {
                        let item = res[i];
                        if (item && item.length > 0) {

                          let tsrq = item[0];
                          if (tsrq.length == 10) {
                            tsrq = tsrq.substring(5); //执行日期
                          }

                          let tishi = item[1];    //简称
                          let leixing = getTypeStr(item[2]);  //类型
                          let dm = item[3];       //债券代码

                          list.push({
                            excuteDate: tsrq,
                            bondCode: dm,
                            bondShortName: tishi,
                            type: leixing
                          });
                        }
                      }
                    }
                  }
                });
                //************ 查询获取今日提示数据 结束 ***********

                // *************** 查询 重要业务提示 栏目  ********************  开始
                $.ajax({
                  url: '/cbiw/trs/content/list',
                  type: 'post',
                  dataType: 'json',
                  data: {
                    channelId: '506',
                    // orderBy: 'ZhiXingRiQi DESC, LeiXing DESC'
                    orderBy: "[{'ZhiXingRiQi': 'd'}, {'LeiXing': 'D'}]"
                  },
                  async: false,
                  success: function (data) {
                    if (data && data.success && data.data && data.data.length > 0) {
                      for (let i = 0, len = data.data.length; i < len; i++) {
                        let dat = data.data[i];
                        list.push({
                          excuteDate: dat.ZhiXingRiQi,
                          bondCode: dat.ZhaiQuanDaiMa,
                          bondShortName: dat.DOCTITLE,
                          href: dat.DOCPUBURL,
                          type: dat.LeiXing
                        });
                      }
                    }
                  },
                  error: function (err) {
                    // console.log('重要业务提示 - 查询 重要业务提示 栏目 异常 *********** ');
                    // console.error(err);
                  }
                });
                // ************************ 查询 重要业务提示 栏目 *********************  结束

                // 对数据集进行重排序
                // console.log("=------list中的数据", list);
                list.sort(function (a, b) {
                  if (a.excuteDate === undefined) {
                    a.excuteDate = ''
                  }
                  if (a.type === undefined) {
                    a.type = '';
                  }
                  if (a.bondCode === undefined) {
                    a.bondCode = '';
                  }
                  if (!a.excuteDate && !b.excuteDate) {
                    return a.type.localeCompare(b.type);
                  } else if (!a.excuteDate) {
                    return -1;
                  } else if (!b.excuteDate) {
                    return 1;
                  }

                  let ss = a.excuteDate.localeCompare(b.excuteDate);
                  if (ss == 0) {
                    return a.type.localeCompare(b.type);
                  } else {
                    return ss;
                  }
                });

                let htmCont = '', compareDate = "", isDrawLine = false;
                for (let i = 0, ll = list.length; i < ll; i++) {
                  let tmpObj = list[i];

                  if (compareDate == tmpObj.excuteDate) {
                    isDrawLine = false;
                  } else {
                    isDrawLine = true;
                  }

                  compareDate = tmpObj.excuteDate;
