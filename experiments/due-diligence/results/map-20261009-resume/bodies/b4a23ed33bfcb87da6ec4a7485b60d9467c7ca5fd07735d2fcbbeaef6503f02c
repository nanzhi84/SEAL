							var sn = []
							for (var i = 0; i < res.data.records.length; i++) {
								if (contains(gn, res.data.records[i].id)) {
									sn.push(res.data.records[i])
								}
							}
							getNewContent(gn.concat(sn))
						}
					});
				}
			});
		}

		function contains(gn, val) {
			for (var j = 0; j < gn.length; j++) {
				if (val == gn[j].id) {
					return false
