			if ($('#headerdiv').attr('data-val') == 'close' && $('.mainbody').css('display') == 'block' && !mySwiper) {
				//加载轮播效果
				mySwiper = new Swiper('.swiper-container', {
					pagination: '.pagination',
					paginationClickable: true,
					loop: true,
					grabCursor: false,
					autoplay: 3000
				})
			}
		}
		/**
		 * 加载cms内容
		 * @param {Object} channelCode 栏目编码
		 * @param {Object} domId
		 * @param {Object} rows 查询条数
		 */
		function loadCmsContent(channelCode, domId, rows) {
			ajax({
				url: "/cmscontent/web/queryByPageGdContent",
				type: "GET",
				data: {
					'channelCode': channelCode,
					'rows': rows
				},
				success: function(res) {
					Fxtpl.render(domId, res.data);
				}
			});
		}
		$("#more").on('click', function() {
			goToPage("page/creditDynamics/index.html?channelCode=XYDT")
		})
		$('.index-tabList .cup:not(.fr)').on('mouseover', function() {
			$(this).addClass('index-tabList-actived')
			$(this).siblings().removeClass('index-tabList-actived')
			$("#more").unbind("click")
			hotNewsIndex = $(this).index()
			if ($(this).index() == 1) {
				//加载政声传递
				loadZSContent()
				$("#more").on('click', function() {
					goToPage('http://www.gd.gov.cn/xxts/', 'y')
				})
			}
			if ($(this).index() == 0) {
				//新闻动态
				loadHostContent()
				$("#more").on('click', function() {
					goToPage("page/creditDynamics/index.html?channelCode=XYDT")
				})
			}
			$('.dbzx').eq($(this).index()).removeClass('hiddom').siblings().addClass('hiddom');
		})
		//加载政声传递列表数据
		function loadZSContent() {
			$.ajax({
				url: 'https://app.gd.gov.cn/xxts/pushinfo_json.php',
				dataType: "jsonp",
				jsonp: "pushInfoJsonpCallBack",
				jsonpCallback: "pushInfoJsonpCallBack",
				success: function(res) {
					$.each(res, function(index, item) {
						item.channelName = '政声传递'
						item.description = ''
						item.origin = '广东省人民政府门户网站'
						item.releaseDate = item.pubDate
						item.externalLink = item.link
					})
					if (hotNewsIndex == 1) {
						Fxtpl.render('index-tab-2', {
							records: res.slice(0, 6)
						});
					}
				}
			});
		}
		//加载信用承诺
		/* loadXycn();
		function loadXycn() {
			ajax({
				url: "/promise/web/pageList",
				type: "GET",
				data: { 'rows': 5 },
				success: function (res) {
					Fxtpl.render("xycn", res.data);
				}
			});
		} */
		//加载行政处罚
		// loadInfoClsDataByLucene('t_xydak_sgs_xzcfxx_', 'xzcf', 5, JSON.stringify([{ CF_JDRQ: "desc" }]));
		//加载行政许可
		// loadInfoClsDataByLucene('t_xydak_sgs_xzxkxx_', 'xzxk', 5, JSON.stringify([{ XK_JDRQ: "desc" }]));
		//加载数据更新情况
		//loadInfoClsData('V_STATISTICS_DEPT_REPORTS', 'deptReports', 100);
		/**
		 * 查询目录数据
		 * @param {Object} clsCode 目录编码
		 * @param {Object} domId
		 * @param {Object} rows 查询条数
		 * @param {Object} orderArgs 排序参数
		 */
		function loadInfoClsData(clsCode, domId, rows, orderArgs) {
			ajax({
				url: "/infoclass/web/pageLoadDataByInclsCode",
				type: "GET",
				data: {
					'clsCode': clsCode,
					'rows': rows,
					orderArgs: orderArgs
				},
				success: function(res) {
					Fxtpl.render(domId, res.data);
					if (domId == 'deptReports') {
						$('.gundong').liMarquee({
							direction: 'up',
							circular: true,
							scrollamount: 20
							//runshort:false
						});
					}
				}
			});
		}

		function loadInfoClsDataByLucene(clsCode, domId, rows, orderArgs) {
			/* Fxtpl.render(domId, null); */
			ajax({
				url: "/luceneidx/web/booleanQueryListByPageV2",
				type: "POST",
				timeout: 60000,
				data: {
					'tableName': clsCode,
					'rows': rows,
					orderArgs: orderArgs
				},
				success: function(res) {
					res.data.rows = res.data.rows.slice(0, 14)
					Fxtpl.render(domId, res.data);
					if (domId == 'deptReports') {
						$('.gundong').liMarquee({
							direction: 'up',
							circular: true,
							scrollamount: 20
							//runshort:false
						});
					}
				}
			});
		}
		loadInfoClsDataByLucene('v_ztk_03_sgs_xzxk', 'xzxk_', 20, JSON.stringify([{
			xk_jdrq_sort: "desc"
		}]));
		$(".tabsItem").mouseover(function() {
			$(this).addClass('activeL')
			$(this).siblings().each(function() {
				$(this).removeClass('activeL')
			})
			$('.tabsBodyItem').eq($(this).index()).removeClass('hiddom').siblings().addClass('hiddom');
			if ($(this).index() == 0) {
				//加载行政许可
				loadInfoClsDataByLucene('v_ztk_03_sgs_xzxk', 'xzxk_', 20, JSON.stringify([{
					xk_jdrq_sort: "desc"
				}]));
			} else if ($(this).index() == 1) {
				//加载行政处罚
				loadInfoClsDataByLucene('v_ztk_03_sgs_xzcf', 'xzcf_', 20, JSON.stringify([{
					cf_jdrq_sort: "desc"
				}]));
			} else if ($(this).index() == 2) {
				loadInfoClsDataByLucene('T_XYYYK_GSLM_CSSXZTMD', 'cssx_', 14, JSON.stringify([{
					'UPDATETIME': "desc"
				}]));
			} else if ($(this).index() == 3) {
				loadInfoClsDataByLucene('T_XYYYK_GSLM_YZSXZTMD', 'yzsx_', 14, JSON.stringify([{
					'UPDATETIME': "desc"
				}]));
			}
		})
		//显示浮窗
		if (!sessionStorage.getItem('floatWindowhide')) {
			$('.hlw-dc').show()
		}
		//关闭浮窗
		function closeFloatWindow() {
			$('.hlw-dc').hide()
			sessionStorage.setItem('floatWindowhide', '1')
		}
		//公告详情弹窗
		function openNoticeModal() {
			$('#hlwOverlay').addClass('show')
		}

		function closeNoticeModal() {
			$('#hlwOverlay').removeClass('show')
		}
		//点遮罩关闭
		$('#hlwOverlay').on('click', function(e) {
			if (e.target === this) {
				closeNoticeModal()
			}
		})
		//Esc关闭
		$(document).on('keydown', function(e) {
			if (e.keyCode === 27) {
				closeNoticeModal()
			}
		})
	</script>
</body>

