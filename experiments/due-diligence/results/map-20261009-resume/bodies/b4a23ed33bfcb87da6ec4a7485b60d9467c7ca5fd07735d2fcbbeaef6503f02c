		//对比国内和省内六篇文章，选择最新六篇
		function getNewContent(list) {
			for (var i = 0; i < list.length; i++) {
				list[i].releaseDate = list[i].releaseDate + ' ' + list[i].createTime.split(' ')[1]
			}
			list.sort(function(a, b) {
				return b.releaseDate < a.releaseDate ? -1 : 1
			})
