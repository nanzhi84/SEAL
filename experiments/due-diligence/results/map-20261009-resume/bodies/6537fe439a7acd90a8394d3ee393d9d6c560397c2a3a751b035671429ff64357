<script>
									(function() {
										function initLinkMenu(con) {
											const btn = con.querySelector('.select_box');
											const menu = con.querySelector('.link_tipd');
											if (!btn || !menu) return;

											// 补齐 ARIA 关联
											if (!btn.id) btn.id = 'linkMenuBtn-' + Math.random().toString(36).slice(2);
											if (!menu.id) menu.id = 'linkMenu-' + Math.random().toString(36).slice(2);
											btn.setAttribute('aria-controls', menu.id);
											menu.setAttribute('aria-labelledby', btn.id);

											const items = () => Array.from(menu.querySelectorAll('[role="menuitem"]'));

											function isOpen() {
												return btn.getAttribute('aria-expanded') === 'true';
											}

											function openMenu(focusFirst) {
												// 先关闭其他已打开的下拉
												document.querySelectorAll('.select_con .select_box[aria-expanded="true"]').forEach(
												otherBtn => {
													if (otherBtn !== btn) {
														otherBtn.setAttribute('aria-expanded', 'false');
														otherBtn.classList.remove('on');
														const otherMenu = document.getElementById(otherBtn.getAttribute(
															'aria-controls'));
														if (otherMenu) otherMenu.setAttribute('hidden', '');
													}
												});

												menu.removeAttribute('hidden');
												btn.setAttribute('aria-expanded', 'true');
												btn.classList.add('on');

												if (focusFirst) {
													const first = items()[0];
													if (first) first.focus();
												}
											}

											function closeMenu(returnFocus) {
												menu.setAttribute('hidden', '');
												btn.setAttribute('aria-expanded', 'false');
												btn.classList.remove('on');
												if (returnFocus) btn.focus();
											}

											// 按钮：点击
											btn.addEventListener('click', (e) => {
												e.stopPropagation();
												isOpen() ? closeMenu(false) : openMenu(false);
											});

											// 按钮：键盘
											btn.addEventListener('keydown', (e) => {
												switch (e.key) {
													case 'ArrowDown':
													case 'Enter':
													case ' ':
														e.preventDefault();
														openMenu(true);
														break;
													case 'ArrowUp':
														e.preventDefault();
														openMenu(false);
														const list = items();
														if (list.length) list[list.length - 1].focus();
														break;
												}
											});

											// 菜单内键盘
											menu.addEventListener('keydown', (e) => {
												const list = items();
												const idx = list.indexOf(document.activeElement);
												if (idx === -1) return;

												switch (e.key) {
													case 'ArrowDown':
														e.preventDefault();
														list[(idx + 1) % list.length].focus();
														break;
													case 'ArrowUp':
														e.preventDefault();
														list[(idx - 1 + list.length) % list.length].focus();
														break;
													case 'Home':
														e.preventDefault();
														list[0].focus();
														break;
													case 'End':
														e.preventDefault();
														list[list.length - 1].focus();
														break;
													case 'Escape':
														e.preventDefault();
														closeMenu(true);
														break;
													case 'Tab':
														// 离开菜单时关闭，不阻止默认 Tab 行为
														closeMenu(false);
														break;
												}
											});

											// ★ 新增：点击或回车菜单项后，隐藏当前面板
											menu.addEventListener('click', (e) => {
												const link = e.target.closest('[role="menuitem"]');
												if (!link) return;
												// 不 return false，让链接自身的 onclick（goLink）继续执行
												closeMenu(false);
											});
										}

										// 初始化页面上所有下拉
										document.querySelectorAll('.select_con').forEach(initLinkMenu);

										// 点击外部关闭所有下拉
										document.addEventListener('click', (e) => {
											if (e.target.closest('.select_con')) return;
											document.querySelectorAll('.select_con .select_box[aria-expanded="true"]').forEach(btn => {
												btn.setAttribute('aria-expanded', 'false');
												btn.classList.remove('on');
												const menu = document.getElementById(btn.getAttribute('aria-controls'));
												if (menu) menu.setAttribute('hidden', '');
											});
										});
									})();

									var isCheck = false;
									$("#checkbox").click(function() {
										isCheck = $('#checkbox').is(":checked");
									});

									function goLink(urls) {
										if (isCheck) {
											window.open(urls);
										} else {
											$("#opa_bg").show();
											$("#links").text(urls);
											$("#link_url").attr('href', urls);
										}
									}

									$("a.close_btnd").click(function() {
										$("#opa_bg").hide();
									});

									function openLink() {
										$("#opa_bg").hide();
									}
								</script>

					
					</div>
				</div>
			</div>
		</div>
	
</div>

</div>
</body></html>