						<script>
											(function() {
												const tablist = document.getElementById('dishi_nav');
												const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
												const panels = tabs.map(t => document.getElementById(t.getAttribute('aria-controls')));

												let currentIndex = tabs.findIndex(t => t.getAttribute('aria-selected') === 'true');
												if (currentIndex < 0) currentIndex = 0;

												function activate(index, focusTab) {
													tabs.forEach((tab, i) => {
														const selected = i === index;
														tab.setAttribute('aria-selected', selected ? 'true' : 'false');
														tab.tabIndex = selected ? 0 : -1;
														tab.classList.toggle('active', selected);

														const panel = panels[i];
														if (panel) {
															if (selected) {
																panel.removeAttribute('hidden');
															} else {
																panel.setAttribute('hidden', '');
															}
														}
													});
													currentIndex = index;
													if (focusTab) tabs[index].focus();
												}

												// 鼠标点击
												tabs.forEach((tab, i) => {
													tab.addEventListener('click', () => activate(i, false));
												});

												// 键盘
												tablist.addEventListener('keydown', (e) => {
													const key = e.key;
													let next = null;

													switch (key) {
														case 'ArrowRight':
															next = (currentIndex + 1) % tabs.length;
															break;
														case 'ArrowLeft':
															next = (currentIndex - 1 + tabs.length) % tabs.length;
															break;
														case 'Home':
															next = 0;
															break;
														case 'End':
															next = tabs.length - 1;
															break;
														case 'Enter':
														case ' ':
															e.preventDefault();
															activate(currentIndex, false);
															return;
														default:
															return;
													}

													e.preventDefault();
													activate(next, true);
												});

												// 初始化
												activate(currentIndex, false);
											})();
										</script>
