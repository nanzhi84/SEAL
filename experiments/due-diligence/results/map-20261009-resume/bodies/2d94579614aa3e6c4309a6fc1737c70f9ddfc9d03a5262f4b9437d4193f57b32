        //判断当前窗口是否有顶级窗口，如果有就让当前的窗口的地址栏发生变化，
        function loadTopWindow() {
            //取得浏览器的userAgent字符串
            var userAgent = navigator.userAgent;
            //判断是否IE浏览器
            var isIE = userAgent.indexOf("compatible") > -1 && userAgent.indexOf("MSIE") > -1;
            if (isIE) {
                var reIE = new RegExp("MSIE (\\d+\\.\\d+);");
                reIE.test(userAgent);
                var fIEVersion = parseFloat(RegExp["$1"]);
                if (fIEVersion < 10 || !isSupportPlaceholder()) {
                    layer.alert("本系统支持IE10及以上、Firefox、Chrome最新版本，当前浏览器为IE" + fIEVersion + "，请下载并安装Chrome。", {}, function (index) {
                        window.location.href = "https://www.google.cn/chrome/";
                    });
                }
            }
            if (window.top != null && window.top.document.URL != document.URL) {
                window.top.location = document.URL; //这样就可以让登陆窗口显示在整个窗口了
            }
        }

    </script>
