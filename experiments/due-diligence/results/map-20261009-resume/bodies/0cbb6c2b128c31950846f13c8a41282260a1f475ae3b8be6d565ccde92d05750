    }

    //递归拼接要传递的当前位置
    function getParents(node ,str){
        var parentNode = node.getParentNode();
        if(parentNode != null){
            str = getParents(parentNode ,str);
        }
        str += node.node_id+","+node.text+"_";
        return str;
    }


