        {text:'240%', scale: 2.4},
        {text:'270%', scale: 2.7},
        {text:'300%', scale: 3.0}
    ];
    var scale = 9;
    
    var curScare = (document.body.clientWidth/$('.page:eq(0)').width());
    var page = 13;
