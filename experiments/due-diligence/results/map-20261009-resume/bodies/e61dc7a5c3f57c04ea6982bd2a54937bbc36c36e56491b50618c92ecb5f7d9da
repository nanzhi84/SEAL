      document.querySelector('#verifyCode').value = val
    }
    
    
    var viewerHeight = 0;
       var scaleArray = [
        {text:'10%', scale: 0.1},
        {text:'20%', scale: 0.2},
        {text:'30%', scale: 0.3},
        {text:'40%', scale: 0.4},
