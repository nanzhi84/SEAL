    for(var i in scaleArray){
        if(curScare<1&&i<curScare*10){
            scale = i-1;
        }
        var option = $('<option value="'+scaleArray[i].scale+'">'+scaleArray[i].text+'</option>');
        $('#scaleSelect').append(option)
    }
    if(scale>4){
        scale = 4;
    }
    $('#scaleSelect').val(scaleArray[scale].scale);
    $('#scaleSelect').change(function(){
        changeScare();
    });
    function changeScare(){
        for(var i in scaleArray){
            if(scaleArray[i].scale==$('#scaleSelect').val()){
                scale = i;
                break;
            }
        }
        $('#viewer').css('transform','scale('+$('#scaleSelect').val()+')');
        initPages();
        $('#viewer').css('height',viewerHeight*Number($('#scaleSelect').val())+'px');
    }
    changeScare();
       $('#zoomIn').click(function(){
           if(scale<(scaleArray.length-1)){
               var s = scaleArray[++scale];
               zoom(s);
           }
       })
       $('#zoomOut').click(function(){
           if(scale>0){
               var s = scaleArray[--scale];
               zoom(s);
           }
       })
       $('#viewer').css('transform-origin','top');
       function zoom(s){
           $('#viewer').css('transform','scale('+s.scale+')');
           $('#viewer').css('height',viewerHeight*s.scale+'px');
           $('#scaleSelect').val(s.scale);
           initPages();
       }
       
       function initPages(){
           pages = [];
           $('#viewer .page').each(function(){
               $(this).css('width',parseInt($(this).width()/10)*10+'px'); 
               $(this).css('height',parseInt($(this).height()/10)*10+'px');
               pages.push({id:$(this).attr('id'), top: $(this).offset().top+$('#viewerContainer').scrollTop(), time: 0});
           });
           if(viewerHeight==0) {
               viewerHeight = $('#viewer').height();
           }
       }
       function jump(p){
           $('#pageNumber').val(p);
           $('#viewerContainer').scrollTop(pages[p-1].top);
       }
       $('#pageNumber').change(function(){
           if($('#pageNumber').val()<1){
               $('#pageNumber').val(1);
           } else if($('#pageNumber').val()>page){
               $('#pageNumber').val(page);
           }
           jump($('#pageNumber').val());
    });
       $('#previous').click(function(){
           if(curPage>1){
               --curPage;
               jump(curPage);
           }
       })
       $('#next').click(function(){
           if(curPage<page){
               ++curPage;
               jump(curPage);
           }
       })
       
       initPages();
       
       function getImage($page) {
           var bg = $page.attr('bg');
        var $pages = $('.page[bg="'+bg+'"]');
           $pages.removeAttr('bg');
           
        let request = new XMLHttpRequest();
           request.responseType = 'blob';
           request.open('get', 'viewGbImg?fileName='+bg, true);
           
           request.setRequestHeader('Cache-Alive', 'chunked'); 
           request.onreadystatechange = e => {
            if (request.readyState == XMLHttpRequest.DONE && request.status == 200) { 
                var src = URL.createObjectURL(request.response);
                $pages.find('span').css('background-image','url("'+src+'")');
                setTimeout(function() {
                    URL.revokeObjectURL(src);
                }, 200);    
               }
           };
           request.send(null);
    }
       
       function initImage(i){
           $page = $('.page:eq('+i+')');
        var bg = $page.attr('bg');
        if(bg!=null){
            getImage($page);
        }
       }
       
       $('#viewerContainer').scroll(function(){
           var t = $('#viewerContainer').scrollTop();
           // 固定导航
           if(t>33){
               var cachePage = page;
               for(var i in pages){
                   var inum = Number(i);
                   if(pages[i].top-10>t){
                       cachePage = inum;
                       break;
                   }
               }
               curPage = cachePage;
               $('#pageNumber').val(curPage);
               initImage(curPage);
           }
       });
       initImage(0);
       
       setInterval(function() {
           totalTime++;
           var time = pages[curPage-1].time + 1;
           pages[curPage-1].time = time;
        //console.log(curPage+':'+time);
    }, 1000);
       
       window.onbeforeunload = function () {
        console.log('关闭');

           var vp = 0;
           for(var i in pages){
               var inum = Number(i);
               if(pages[i].time>=10){
                   vp++;
               }
               }
           var rate = vp/pages.length;
           var data = {'hcno':'7748303C2F7D709A9539BA53E57F9BE1','time':totalTime,'rate':rate};
           if("sendBeacon" in navigator) {
               const formData = new FormData();
               
               Object.keys(data).forEach((key) => {
                  let value = data[key];
                  if (typeof value !== "string") {
                    value = JSON.stringify(value);
                  }
                  formData.append(key, value);
                 });
                
                const joinedQueue = navigator.sendBeacon("onlineLog", formData);
                console.log('数据加入传输队列' + (joinedQueue ? '成功' : '失败'));
