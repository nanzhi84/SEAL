                }
            }
            timer_1 = setInterval(scroll_1, 2500);
            $(".btn_prev").click(function () {
                if ($(" .focus_box ul:animated").length == 0) {
                    clearInterval(timer_1);
                    $(" .focus_box ul").css("marginLeft", -590).prepend($(" .focus_box ul li").eq(-1));
                    $(" .focus_box ul").stop(0).animate({"marginLeft": 0}, 500, function () {
                        timer_1 = setInterval(scroll_1, 2500);
                        cur_num==1? cur_num=focus_num:cur_num--;
                        show_num(cur_num);
                    });
                }
            });
            $(".btn_next").click(function () {
                if ($(".focus_box ul:animated").length == 0) {
                    clearInterval(timer_1);
                    $(".focus_box ul").stop(0).animate({"marginLeft": -590}, 500, function () {
                        $(".focus_box ul").append($(" .focus_box ul li").eq(0)).css("marginLeft", 0);
                        timer_1 = setInterval(scroll_1, 2500);
                        cur_num==focus_num? cur_num=1:cur_num++;
                        show_num(cur_num);
                    });
                }
            });

            /*友情链接*/
            var yqlj_l = parseFloat($(".yqlj_lists").width())-960;
            var yqlj_num = Math.ceil(yqlj_l/480);
            var yqlj_last = yqlj_l-480*(yqlj_num-1);

            var btn_num = 0;
            $(".yqlj .yqlj_cont .yqlj_next").click(function(){
                btn_num++;
                if(btn_num==yqlj_num){
                    $(".yqlj_lists").stop(0).animate({"marginLeft": -yqlj_last-(btn_num-1)*480}, 500, function () {});
                    $(".yqlj .yqlj_cont .yqlj_prev").show();
                    $(".yqlj .yqlj_cont .yqlj_next").hide();
                }else{
                    $(".yqlj_lists").stop(0).animate({"marginLeft": -btn_num*480}, 500, function () {});
                    $(".yqlj .yqlj_cont .yqlj_prev").show();
                }
            });
            $(".yqlj .yqlj_cont .yqlj_prev").click(function(){
                btn_num--;
                if(btn_num==0){
                    $(".yqlj_lists").stop(0).animate({"marginLeft": 0}, 500, function () {});
                    $(".yqlj .yqlj_cont .yqlj_prev").hide();
                    $(".yqlj .yqlj_cont .yqlj_next").show();
                }else{
                    $(".yqlj_lists").stop(0).animate({"marginLeft": -btn_num*480}, 500, function () {});
                    $(".yqlj .yqlj_cont .yqlj_next").show();

                }
            })
			
			
			$(window).on("scroll", function(){
			// 回到顶部
        	if ($(window).scrollTop() > 600) {
            	$("#scrollTop").fadeIn();
        	}else{
           	     $("#scrollTop").fadeOut();
        	}
        	$(" #scrollTop").click(function(){
            	$("html, body").stop().animate({scrollTop:0}, 500);
        	});
		
		});
			
			
    })
