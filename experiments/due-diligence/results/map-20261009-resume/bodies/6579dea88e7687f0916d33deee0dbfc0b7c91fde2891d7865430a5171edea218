    //只能输入数字（包含小数）
    function numberType(obj) {
        var va = obj.value;
        if (isNaN(va)) {
            obj.value = '';
            XWK.alert('请输入正确的数值！', 'error');
            return;
        }
        va = Number(va);
        var flag = /^\d+(\.\d+)?$/.test(va);
        if (!flag) {
            obj.value = va.replace(/[^\d\.]/g, '');
        } else {
            obj.value = va;
        }
    }
    //只能输入数字（包含小数和负数）
    function numberTypeFloat(obj) {
        var va = obj.value;
        if (isNaN(va)) {
            obj.value = '';
            XWK.alert('请输入正确的数值！', 'error');
            return;
        }
        va = Number(va);
        var flag = /^(-)?\d+(\.\d+)?$/.test(va);
        if (!flag) {
            obj.value = va.replace(/[^\d\.-]/g, '');
        } else {
            obj.value = va;
        }
    }
    //只能输入数字（不包含小数和负数）
    function numberTypeInt(obj) {
        var va = obj.value;
        if (isNaN(va)) {
            obj.value = '';
            XWK.alert('请输入正确的数值！', 'error');
            return;
        }
        va = Number(va);
        var flag = /^[0-9]*$/.test(va);
        if (!flag) {
            //alert("请您输入正整数！")
            obj.value = va.replace(/[^\d]/g, '');
        } else {
            obj.value = va;
        }
    }
    //保留小数位数
    function numberPoint(obj, length) {
        var va = obj.value;
        var vaback = va;
        if (/^-/.test(va)) {
            numberTypeFloat(obj);
        } else {
            numberType(obj);
        }
        var va = obj.value;
        if (va == '' && vaback == 'T') {
            obj.value = vaback;
        }
        if (isNaN(va) && vaback != 'T') {
            obj.value = "";
            return;
        }
        if (doNull(va) != '' && doNull(length) != '') {
            var s = va.indexOf('.');
            if (s == 0) {
                obj.value = "";
                return;
            }
            var s2 = va.indexOf('-.');
            if (s2 == 0) {
                obj.value = "";
                return;
            }
            if (s < 0) {
                var zero = ".";
                for (var i = 0; i < length; i++) {
                    zero += "0";
                }
                obj.value = va + zero;
            } else {
                var len = va.substring(s + 1, va.length).length;//小数点后数字的长度
                if (len < length) {
