            // 如果传入的参数是对象，则将其添加到URLSearchParams中
            if (typeof params === 'object' && params !== null) {
                Object.keys(params).forEach(key => {
                    if (params[key] !== undefined && params[key] !== '') {
                        defaultParams.append(key, params[key]);
                    }
                });
