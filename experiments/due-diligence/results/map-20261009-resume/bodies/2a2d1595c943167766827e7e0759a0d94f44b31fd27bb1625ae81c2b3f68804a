          var tt = (
[{"summary":"新华社北京9月7日电 为深入推动习近平生态文明思想进教材进课堂进头脑，由中央宣传部、生态环境部组织编写的马克思主义理论研究和建设工程重点教材《习近平生态文明思想概论》（以下简称《概论》）一书，已由高等教育出版社、人民出版社出版。","classify":0,"images":[{}],"relationUrl":"/jxszrzyt/sytt/relation/2097151958999183360-RelationArticle.json","attDownloadType":0,"title":"《习近平生态文明思想概论》出版发行","type":0,"pubDate":"2026-09-08 10:35","relation":0,"urls":"{\"pc\":\"/jxszrzyt/sytt/content/content_2097151958999183360.html\"}","contentSource":"新华社","showTitle":"《习近平生态文明思想概论》出版发行","topStatus":0,"archiveStatus":0,"sortNum":17888349000011077,"id":"2097151958999183360","articleFiles":[{}]},{"summary":"营造良好的政治生态，是我们党的优良传统和政治优势。7月30日召开的中共中央政治局会议强调：“以党的政治建设为统领，全面推进党的各方面建设，充分激发全党积极性主动性创造性，不断实现党的自我净化、自我完善、自我革新、自我提高”。8月22日举行的二十届中央纪委六次全会指出，“牢固树立和践行正确政绩观，加强政治监督，深化政治巡视，严明换届纪律，坚定不移正风肃纪反腐，持续深化群众身边不正之风和腐败问题集中整治”。","classify":0,"images":[{}],"relationUrl":"/jxszrzyt/sytt/relation/2092066965137203200-RelationArticle.json","attDownloadType":0,"title":"总书记的人民情怀 | “营造风清气正的政治生态”","type":0,"pubDate":"2026-08-25 09:49","relation":0,"urls":"{\"pc\":\"/jxszrzyt/sytt/content/content_2092066965137203200.html\"}","contentSource":"人民日报","topStatus":0,"archiveStatus":0,"sortNum":17876225400092552,"id":"2092066965137203200","articleFiles":[{}]},{"summary":"发展和安全是一体之两翼、驱动之双轮。习近平总书记深刻把握时与势、洞察危与机，鲜明提出“要坚持高质量发展和高水平安全相互促进，努力提升粮食能源资源安全保障能力”。","classify":0,"images":[{}],"relationUrl":"/jxszrzyt/sytt/relation/2086715680368173056-RelationArticle.json","attDownloadType":0,"title":"总书记的人民情怀 | “努力提升粮食能源资源安全保障能力”","type":0,"pubDate":"2026-08-10 15:24","relation":0,"urls":"{\"pc\":\"/jxszrzyt/sytt/content/content_2086715680368173056.html\"}","contentSource":"人民日报","topStatus":0,"archiveStatus":0,"sortNum":17863466400036989,"id":"2086715680368173056","articleFiles":[{}]},{"summary":"同志们，朋友们：\n  今天，我们隆重集会，庆祝中国共产党成立105周年，回顾我们党走过的光辉历程，展望党和人民事业发展的光明前景，动员全党全国各族人民满怀信心朝着全面建成社会主义现代化强国、实现中华民族伟大复兴的宏伟目标奋勇前进。","classify":0,"images":[{}],"relationUrl":"/jxszrzyt/sytt/relation/2072509447023534080-RelationArticle.json","attDownloadType":0,"title":"习近平：在庆祝中国共产党成立105周年大会上的讲话","type":0,"pubDate":"2026-07-02 10:29","relation":0,"urls":"{\"pc\":\"/jxszrzyt/sytt/content/content_2072509447023534080.html\"}","contentSource":"新华社","topStatus":0,"archiveStatus":0,"sortNum":17829593400093902,"id":"2072509447023534080","articleFiles":[{}]},{"summary":"中共中央党史和文献研究院编辑的《习近平党建文选》第一卷、第二卷，近日由中央文献出版社出版，在全国发行。党的十八大以来，以习近平同志为核心的党中央围绕建设什么样的长期执政的马克思主义政党、怎样建设长期执政的马克思主义政党的重大时代课题，提出一系列新理念新思想新战略，形成习近平党建思想。","classify":0,"images":[{}],"relationUrl":"/jxszrzyt/sytt/relation/2069677088574185472-RelationArticle.json","attDownloadType":0,"title":"《习近平党建文选》第一卷、第二卷出版发行","type":0,"pubDate":"2026-06-24 14:59","relation":0,"urls":"{\"pc\":\"/jxszrzyt/sytt/content/content_2069677088574185472.html\"}","contentSource":"新华社","topStatus":0,"archiveStatus":0,"sortNum":17822843400041640,"id":"2069677088574185472","articleFiles":[{}]},{"summary":"2023年6月2日，习近平总书记在文化传承发展座谈会上发表重要讲话，深刻阐释中华文化传承发展的重大理论和现实问题，发出“赓续历史文脉、谱写当代华章”的时代号召。党的十八大以来，在习近平文化思想科学指引下，新时代文化建设守正创新、步履铿锵，文脉赓续绵延、文化活力迸发，一幅古老文明与现代文明交相辉映的绚丽图景在神州大地徐徐铺展。","classify":0,"images":[{}],"relationUrl":"/jxszrzyt/sytt/relation/2061712091730456576-RelationArticle.json","attDownloadType":0,"title":"习近平文化思想引领文化传承发展开创新局面","type":0,"pubDate":"2026-06-02 15:21","relation":0,"urls":"{\"pc\":\"/jxszrzyt/sytt/content/content_2061712091730456576.html\"}","contentSource":"新华社","showTitle":"习近平文化思想引领文化传承发展开创新局面","topStatus":0,"archiveStatus":0,"sortNum":17803848600052567,"id":"2061712091730456576","articleFiles":[{}]},{"summary":"新华社北京4月29日电 中共中央政治局4月28日下午就提高防灾减灾救灾能力进行第二十五次集体学习。中共中央总书记习近平在主持学习时强调，要站在统筹高质量发展和高水平安全的战略高度，充分认识做好防灾减灾救灾工作的重要性，着力提高防范应对自然灾害能力，切实维护人民群众生命财产安全。","classify":0,"images":[{}],"relationUrl":"/jxszrzyt/sytt/relation/2049667555735375872-RelationArticle.json","attDownloadType":0,"title":"习近平：着力提高防范应对自然灾害能力 切实维护人民群众生命财产安全","type":0,"pubDate":"2026-04-30 09:48","relation":0,"urls":"{\"pc\":\"/jxszrzyt/sytt/content/content_2049667555735375872.html\"}","contentSource":"中国政府网","showTitle":"习近平：着力提高防范应对自然灾害能力 切实维护人民群众生命财产安全","topStatus":0,"archiveStatus":0,"sortNum":17775136800015823,"id":"2049667555735375872","articleFiles":[{}]},{"summary":"近日，中共中央办公厅印发《关于在全党开展树立和践行正确政绩观学习教育的通知》（以下简称《通知》）。《通知》指出，经党中央同意，在全党开展树立和践行正确政绩观学习教育（以下简称学习教育）。学习教育以县处级以上领导班子和领导干部特别是“一把手”为重点，于2026年春节假期后启动、7月底基本结束。","classify":0,"images":[{}],"relationUrl":"/jxszrzyt/sytt/relation/2027575406374162432-RelationArticle.json","attDownloadType":0,"title":"中办印发《通知》在全党开展树立和践行正确政绩观学习教育","type":0,"pubDate":"2026-02-27 10:38","relation":0,"urls":"{\"pc\":\"/jxszrzyt/sytt/content/content_2027575406374162432.html\"}","contentSource":"中国政府网","showTitle":"中办印发《通知》在全党开展树立和践行正确政绩观学习教育","topStatus":0,"archiveStatus":0,"sortNum":17721598800030812,"id":"2027575406374162432","articleFiles":[{}]},{"summary":"新华社北京1月12日电 中共中央总书记、国家主席、中央军委主席习近平12日上午在中国共产党第二十届中央纪律检查委员会第五次全体会议上发表重要讲话。他强调，要坚持和加强党的全面领导，以更高标准、更实举措推进全面从严治党，更加坚决有力地贯彻落实党中央重大决策部署，更加科学有效地把权力关进制度笼子，更加清醒坚定地推进反腐败斗争，为实现“十五五”时期目标任务提供坚强保障。","classify":0,"images":[{"cover":"/jxszrzyt/sytt/2011257968885690368/UXando4r.jpg","domainName":"http://bnr.jiangxi.gov.cn","filePath":"/jxszrzyt/sytt/2011257968885690368/UXando4r.jpg","delFlag":0,"fileId":"2011257237766225920"}],"relationUrl":"/jxszrzyt/sytt/relation/2011257968885690368-RelationArticle.json","attDownloadType":0,"title":"习近平在二十届中央纪委五次全会上发表重要讲话","type":0,"pubDate":"2026-01-14 09:59","relation":0,"urls":"{\"pc\":\"/jxszrzyt/sytt/content/content_2011257968885690368.html\"}","contentSource":"新华社","topStatus":0,"archiveStatus":0,"sortNum":17683559400010243,"id":"2011257968885690368","articleFiles":[{}]},{"summary":"新华社北京12月30日电 中央农村工作会议29日至30日在北京召开。会议以习近平新时代中国特色社会主义思想为指导，深入贯彻党的二十大和二十届历次全会精神，全面贯彻习近平总书记关于“三农”工作的重要论述和重要指示精神，落实中央经济工作会议精神，分析当前“三农”工作面临的形势和挑战，部署2026年“三农”工作。","classify":0,"images":[{}],"relationUrl":"/jxszrzyt/sytt/relation/2006178109342093312-RelationArticle.json","attDownloadType":0,"title":"中央农村工作会议在京召开 习近平对做好“三农”工作作出重要指示","type":0,"pubDate":"2025-12-31 09:37","relation":0,"urls":"{\"pc\":\"/jxszrzyt/sytt/c