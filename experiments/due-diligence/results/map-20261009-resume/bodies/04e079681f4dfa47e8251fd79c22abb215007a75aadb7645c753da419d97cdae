function autoPlay(){
	play = setInterval(function () {
		h_init = (h_init>=4?0:(h_init+1));
		$(".tabs .active").removeClass('active');
		$("#h"+h_init).addClass('active');
		$(".page").removeClass('actived');
		$("#d"+h_init).addClass('actived');
	},5000); 
}

function _(element){
	if(arguments.length>1){
		for(var i=0,elements=[],length=arguments.length; i<length;i++){
			elements.push($(arguments[i]));
		}
		return elements;
	}else{
		return document.getElementById(element);
	}
}

function ShowButton(i,a){
	var d = "dd" + i;
	var m = "ii" + i;
	if(a==0){
