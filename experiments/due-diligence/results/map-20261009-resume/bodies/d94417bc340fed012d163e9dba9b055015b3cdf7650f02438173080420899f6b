<script>
    layui.use(['form','layer','ax','table','laypage','laytpl','laydate','formutil'], function () {
        var $ = layui.$;
        var layer = layui.layer;
        var $ax = layui.ax;
        var form = layui.form;
        var table = layui.table;
        var laypage = layui.laypage;
        var laytpl = layui.laytpl;
        var laydate = layui.laydate;
        var formutil = layui.formutil;
        var limit = 10;

        var winWidth = $(window).width();
        if(winWidth > 1200){
        	$("#headerTwo").load('common/bdcdjgggs_two.html');
        }
        
        laydate.render({
            elem: '#fbtime'
        });
        //渲染table
        function renderTable(data){
            table.render({
                elem: '#bdcdjgggsTable'
                ,data: data
                ,cellMinWidth: 80
                ,cols: [[
                    {field: 'landaddress', sort: false,align:'center', title: '不动产坐落'},
                    {field: 'applyunit', sort: false,align:'center', title: '申请人'},
                    {field: 'estatenumber', sort: false,align:'center', title: '不动产登记证书或不动产登记证明号'},
                    {field: 'note',width:120, sort: false,align:'center', title: '公告公示内容'},
                    {align: 'center',width:120,field:'fbtime', title: '发布日期', sort: false, templet: function (d) {
                            return formatDate(d.fbtime);
                        }},
                    {field: 'landregorgan', sort: false,align:'center', title: '发布机构'},
                    {field: 'tableBar',align: 'center', toolbar: '#tableXqBar',width:90, title: '查看原件'}
                ]]
                ,text: {
                    none: '暂无相关数据！'
                }
            });
        }

        //渲染分页
        function renderPage(curr,count){
            laypage.render({
                elem: 'bdcdjgggsTablePageDiv'
                ,count: count
                ,limit: limit
                ,curr: curr
                ,groups: 3
                ,prev: '<'
                ,next: '>'
                ,first: 1
                ,layout: ['prev','page','next','count','skip']
                ,theme: '#0973CA'
                ,jump: function(obj, first){
                    if (!first) {
                        getTableDate(obj.curr);
                    }
                }
            });
        }
        //搜索数据
        function getTableDate(page){
            var fbtime;
            if($('#fbtime').val()!=""){
            	fbtime = $('#fbtime').val();
            }
            $ax.req({
                url: serverName.restBasePath+'/bdcdjbdcdjgggs/esSearchList'
                ,data:{ page: page, limit: limit, fbsj: fbtime, landaddress: $('#landaddress').val(), note: $('#note').val(), landregorgan: $('#landregorgan').val()}
                ,done:function(res){
                    if(res.code=='0'){
                        renderTable(res.data);
                        renderPage(page,res.count);
                    }else{
                        layer.msg(res.msg);
                    }
                }
            });
        }

        //初始查第一页数据
        getTableDate(1);

        var $ = layui.$, active = {
            reload: function () {
                getTableDate(1);
            },
            reset: function () {
                $("#fbtime").val('');
                $("#landaddress").val('');
                $("#note").val('');
                $("#landregorgan").val('');
                getTableDate(1);
            }
        };
        fanhui = function(){
            $("#detailDiv").css('display', 'none');
            $("#infoDiv").css('display', 'block');
        }

        $('.layui-btn').on('click', function () {
            var type = $(this).data('type');
            active[type] ? active[type].call(this) : '';
        });


        //监听工具条
        table.on('tool(bdcdjgggsTable)', function (obj) {
            var data = obj.data;
            if (obj.event === 'xqEvent') {
                var filecode ='bdcdj_bdcdjgggs';
                var objuuid = data.objuuid;
                $ax.req({
                    url: serverName.restBasePath+'/upload/filesEs',
                    data:JSON.stringify({"dataId" : objuuid,"dtos" :[  { previewelem : filecode, filecodes : [filecode] } ]}),
                    type: "POST",
                    async: false,
                    contentType: "application/json",
                    done:function(d){
                        if(d.data && d.data.length >0 ){
                            var fileUrl;
                            if(isEmpty(serverName.restFilePath)){
                                fileUrl = serverName.restBasePath + '/upload/renderfilestreamEs?id='+d.data[0].id;
                            }else{
                                fileUrl = serverName.restFilePath+d.data[0].fileUrl;
                            }
                            window.open(fileUrl);
                        }else{
                            layer.msg("没有附件可以查看");
                        }
                    }
                });
            }
        });


    });
</script>

