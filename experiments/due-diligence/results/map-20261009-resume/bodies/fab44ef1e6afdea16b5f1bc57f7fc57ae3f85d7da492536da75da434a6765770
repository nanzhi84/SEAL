    <script type="text/javascript">
        $(document).ready(function () {
            //start();
            createCode();
            document.getElementById('modal_search').style.display = "block";
            $("#inputCode").val("");
            $("#inputCode").focus();

            //点击查询按钮
            $("#search").click(function () {
                var num = $("#num").val();
                if (num == null || null == '') {
                    alert("请输入许可号/批文号/企业名称查询！");
                    return;
                }
                createCode();
                document.getElementById('modal_search').style.display = "block";
                $("#inputCode").val("");
                $("#inputCode").focus();
            });

        });

        function start() {

            var num = $("#num").val();
            var code = $("#inputCode").val();
            var type = $("#type option:selected").val();
            $.ajax({
                type: "POST",
                dataType: "json",
                url: '/dxxzsp/corpinfo/getcorpinfocount.wf',
                data: {
                    num: num,
                    type: type,
                    code: code
                },
                processData: true,
                success: function (data) {
                    if (data.flag == '0') {
                        alert(data.msg);
                        return;
                    }
                    if (data.c == 0) {
                        alert("未查询到【" + htmlEscape(num) + "】企业许可信息！");
                        return;
                    }

                    var count = parseInt(data.c);
                    layui.use('laypage', function () {
                        var laypage = layui.laypage;
                        laypage.render({
                            elem: 'page'
                            , count: count
                            , limit: 10
                            , jump: function (obj, first) {
                                $.ajax({
                                    type: "POST",
                                    dataType: "json",
                                    url: '/dxxzsp/corpinfo/getcorpinfo.wf',
                                    data: {
                                        pageNum: obj.curr,
                                        pageSize: obj.limit,
                                        num: $("#num").val(),
                                        type: $("#type option:selected").val(),
                                        code: $("#inputCode").val()
                                    },
                                    success: function (data) {
                                        var result = data.listyj;
                                        var html = "";

                                        for (var i = 0; i < result.length; i++) {

                                            if (type == "xuke") {
                                            	var company_ywzl = result[i].ywzlInfos;
                                            	for (var j = 0; j < company_ywzl.length; j++) {
                                            					html += "<tr>";
                                            					if (j == 0) {
                                            						html += "<td rowspan='" + company_ywzl.length + "'>" + htmlEscape(result[i].company_name) + "</td>";
                                                                html += "<td rowspan='" + company_ywzl.length + "'>" + htmlEscape(result[i].faren) + "</td>";
                                            						html += "<td rowspan='" + company_ywzl.length + "'>" + htmlEscape(result[i].license_no) + "</td>";
                                                                html += "<td rowspan='" + company_ywzl.length + "'>" + htmlEscape(result[i].fzjg) + "</td>";
                                            					}
                                            					html += "<td class='moretd' title='" + htmlEscape(company_ywzl[j].ywzl) + "'>" + htmlEscape(company_ywzl[j].ywzl) + "</td>";
                                            					html += "<td class='moretd' title='" + htmlEscape(company_ywzl[j].fgfw) + "'>" + htmlEscape(company_ywzl[j].fgfw) + "</td>";
                                            				/*if(result[i].fzjg!="工业和信息化部"){*/
                                                                html += "<td class='moretd'>"+"----------"+"</td>";
                                                            /*}else {
                                                                html += "<td class='moretd' title='" + htmlEscape(company_ywzl[j].fzrq) + "'>" + htmlEscape(company_ywzl[j].fzrq) + "</td>";
                                                            }*/
                                                            html += "<td class='moretd' title='" + htmlEscape(company_ywzl[j].jzrq) + "'>" + htmlEscape(company_ywzl[j].jzrq) + "</td>";
                                            					if (j == 0) {
                                            						html += "<td rowspan='" + company_ywzl.length + "'><a href='javascript:showShouQuan(\"" + htmlEscape(result[i].lic_id) + "\")'>查看详情</a></td>";
                                            					}
                                                            if (j == 0) {
                                                                html += "<td rowspan='" + company_ywzl.length + "'><a href='javascript:showYearReport(\"" + htmlEscape(result[i].lic_id) + "\")'>查看详情</a></td>";
                                                            }
                                            					html += "</tr>";
                                            	}
                                            } else if (type == "ws") {
                                                var areaArr = result[i].rsarea.split(";");
                                                var areaHtml = "";
                                                for (var k = 0; k < areaArr.length; k++) {
                                                    areaHtml += htmlEscape(areaArr[k]) + "<br/>";
                                                }
                                                html += "<tr><td class='moretd' title='" + htmlEscape(result[i].enterprise_name) + "'>" + htmlEscape(result[i].enterprise_name) + "</td><td class='moretd' title='" + htmlEscape(result[i].sdyjs_num) + "'>" + htmlEscape(result[i].sdyjs_num) + "</td><td class='moretd' title='" + htmlEscape(result[i].chinese_investors) + "'>" + htmlEscape(result[i].chinese_investors) + "</td>"
                                                    + "<td class='moretd' title='" + htmlEscape(result[i].foreign_investor) + "'>" + htmlEscape(result[i].foreign_investor) + "</td>" + "<td class='moretd' title='" + htmlEscape(result[i].reg_capital) + "'>" + htmlEscape(result[i].reg_capital) + "</td>" + "<td class='moretd' title='" + htmlEscape(result[i].zfbl) + "'>" + htmlEscape(result[i].zfbl) + "</td>"
                                                    + "<td class='moretd' title='" + htmlEscape(result[i].invest_amounts_) + "'>" + htmlEscape(result[i].invest_amounts_) + "</td>" + "<td class='moretd' title='" + htmlEscape(result[i].associationcontent) + "'>" + htmlEscape(result[i].associationcontent) + "</td>"
                                                    + "<td class='moretd' title='" + htmlEscape(result[i].created) + "'>" + htmlEscape(result[i].created) + "</td></tr>";
                                            }
                                        }
                                        $(".tablelist").empty();
                                        $(".tablelist").append(html);
                                    },
                                    error: function (data) {
                                        alert("未查询企业许可信息！");
                                    }
                                });
                            }
                        });
                    });
                },
                error: function (data) {
                    alert("未查询企业许可信息！");
                }
            });
        }

        function htmlEscape(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        function closed() {
            var inputCode = $("#inputCode").val();
            if (inputCode.length <= 0) {
                alert("请输入验证码！");
                return false;
            }
            document.getElementById('modal_search').style.display = "none";
            start();
        }

        function closed1() {
            document.getElementById('modal_search').style.display = "none";
        }

        function openxuke(entid, num) {
            var safeEntid = encodeURIComponent(entid);
            var safeNum = encodeURIComponent(num);
            window.open("/dxxzsp/xkz/xkzgl/resource/qyxkyw.jsp?entid=" + safeEntid + "&num=" + safeNum);
        }


        function showYearReport(num) {
            var safeNum = encodeURIComponent(num);
            $.ajax({
                type: "POST",
                dataType: "json",
                url: "/dxxzsp/corpinfo/getreporty",
                data: {
                    num: num
                },
                success: function (date) {
                    if (date.ssss!=null){
                        alert("未查询到该企业年报信息！");
                        return;
                    } else {
                        var url = "/dxxzsp/xkz/xkzgl/resource/qiyereport.jsp?num="+safeNum+"&type=yreport";
                        window.open(url);
                    }
                }
            });
        }

        function showShouQuan(num) {
            var safeNum = encodeURIComponent(num);
            var url = "/dxxzsp/xkz/xkzgl/resource/qiyeshuquan.jsp?num="+safeNum;
            window.open(url);
        }

        function createCode() {
            var num = $("#num").val();
            $.ajax({
                url: "/dxxzsp/corpinfo/getCode",
                async: false,
                type: "post",
                dataType: "json",
                data: {
                    num: num
                },
                processData: true,
                success: function (res) {
                    $("#imgcode").attr("src", res.src);
                }, error: function () {
                    alert("连接超时!");
                }
            });
        }

    </script>
