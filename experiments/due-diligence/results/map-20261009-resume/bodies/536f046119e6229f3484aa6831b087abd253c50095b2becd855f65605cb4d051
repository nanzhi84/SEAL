	function getPrice2(sysName,proPrice,proPricePub,priceUnit){
		var res;

		if (doNull(sysName).toLowerCase() == 'utrz') {
			res = proPricePub;
		} else if (Number.parseFloat(proPrice)==0) {
			res = '面议';
		} else if (proPrice==null) {
			res = '待定';
		} else {
			if (doNull(priceUnit).indexOf("万元")>-1) {
				res = toWan(proPrice) + doNull(priceUnit);
			} else {
				res = parseFloat(proPrice).toFixed(2) + doNull(priceUnit);
			}
		}

		return res;
	}

