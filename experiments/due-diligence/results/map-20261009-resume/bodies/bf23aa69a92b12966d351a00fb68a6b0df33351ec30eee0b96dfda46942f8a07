    // 格式化时间，传入标志时间位
    function getLastDateOfSec(dateStr, flagTime) {
      var _newDate = Date.now()
      var _diffSec = parseInt((_newDate - flagTime) / 1000)
      var _diff = dateStr - _diffSec
      if (_diff >= 0) {
        var _day = Math.floor(_diff / (24 * 60 * 60))
        _diff -= (_day * (24 * 60 * 60))
        var _hour = Math.floor(_diff / (60 * 60))
        _diff -= (_hour * (60 * 60))
        var _min = Math.floor(_diff / (60))
        _diff -= (_min * (60))
        var _sec = Math.floor(_diff)
        return (_day > 0 ? _day + '天' : ' ')
          + (( _day > 0 || _hour > 0 ) ? formatNum1(_hour) + '时' : ' ')
          + (( _day > 0 || _hour > 0 || _min > 0 ) ? formatNum1(_min)+ '分' : ' ')
          + formatNum1(_sec) + '秒'
      }
      return '--'
    }
