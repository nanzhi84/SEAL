    function getLeaseDate(dateStr) {
      var _diff = dateStr
      if (_diff > 0) {
        var _day = Math.floor(_diff / (24 * 60 * 60))
        _diff -= (_day * (24 * 60 * 60))
        var _hour = Math.floor(_diff / (60 * 60))
        _diff -= (_hour * (60 * 60))
        var _min = Math.floor(_diff / (60))
        _diff -= (_min * (60))
        var _sec = Math.floor(_diff)
        return (_day > 0 ? formatNum(_day) + '天' : '')
          + (( _day > 0 || _hour > 0 ) ? formatNum(_hour) + '小时' : '')
          + (( _day > 0 || _hour > 0 || _min > 0 ) ? formatNum(_min)+ '分' : '')
          + formatNum(_sec) + '秒'
      }
      return '--'
    }
