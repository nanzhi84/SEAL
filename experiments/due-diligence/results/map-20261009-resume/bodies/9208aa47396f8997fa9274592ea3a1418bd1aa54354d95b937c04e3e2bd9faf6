        windowHeight = $(window).height();//浏览器高度
        windowWidth = $(window).width();//浏览器宽度
      });
      function move() {//定期执行的函数，使元素移动
        var currentPos = obj.position();//获取当前位置，这是JQuery的函数，具体见：http://hemin.cn/jq/position.html
