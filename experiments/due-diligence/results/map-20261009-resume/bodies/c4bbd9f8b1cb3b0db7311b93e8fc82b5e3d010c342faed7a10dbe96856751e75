                            <input type="button" value="获取动态码" class="sendButton" id="loginSendButton" onclick="onSendCode()" />
                        </div></div></li>
                    <li><input type="button" class="submitButton" value="立即登录" onclick="onValidateMobile()" /></li>
                </ul>
            </form>
