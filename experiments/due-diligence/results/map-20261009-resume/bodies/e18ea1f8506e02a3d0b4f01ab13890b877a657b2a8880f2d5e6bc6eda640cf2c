    function checkPasswd(t, e) {
        const passwordRegex = /^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d!@#$%^&*()\-_=+\[\]{}|;:,.<>?/~`'"\\]{8,30}$/;
        if (!passwordRegex.test(e)) {
            return "密码长度应在8-30位之间，可包含大小写英文字母、数字和特殊符号，至少包含英文字母和数字！"
        }
        return "";
    }
    function formatNumber(number) {
        // 转换为字符串，以便操作
        let str = number.toString()

        // 如果是整数，直接返回
        if (!str?.includes('.')) {
            return str
        }

        // 去除末尾的零
        while (str.endsWith('0')) {
            str = str.slice(0, -1)
        }

        // 如果小数点后只剩一个零，也去除
        if (str.endsWith('.')) {
            str = str.slice(0, -1)
        }

        return str
    }

