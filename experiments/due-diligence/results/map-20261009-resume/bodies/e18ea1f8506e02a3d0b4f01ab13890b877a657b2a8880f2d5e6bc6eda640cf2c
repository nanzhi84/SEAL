    // 删除附件信息
    function delProAtta(index, storeIds, electronicUrl, proAttaId, callback) {
        XWK.confirm.xwkDelete(ATTA, '/store/' + storeIds.split('|')[index], '该附件', function () {
            var electronicUrlArr = electronicUrl.split("|");
            var storeIdsArr = storeIds.split("|");
            electronicUrlArr.splice(index, 1);
            storeIdsArr.splice(index, 1);
            // 组装字段
            var newTemp = "";
            var newIds = "";
            for (var i = 0; i < electronicUrlArr.length; i++) {
                newTemp += electronicUrlArr[i] + "|";
            }
            for (var i = 0; i < storeIdsArr.length; i++) {
                newIds += storeIdsArr[i] + "|";
            }
            // 修改proAtta的信息
            apiPut("/proAtta/" + proAttaId, "electronicUrl=" + newTemp.substring(0, newTemp.length - 1) + "&storeIds=" + newIds.substring(0, newIds.length - 1), callback);
        })
    }
