<script>
// ========== 关闭智能客服（使用官方方法 + 备用方法） ==========
function robothiden() {
    // 方法1：尝试调用客服窗口自带的关闭方法
    try {
        if (typeof zbxEmbed !== 'undefined' && zbxEmbed.closeFrameModal) {
            zbxEmbed.closeFrameModal();
            console.log('使用 zbxEmbed.closeFrameModal() 关闭');
        }
    } catch(e) { console.log('zbxEmbed.closeFrameModal 调用失败:', e); }
    
    // 方法2：尝试调用 iframe 内部的关闭方法
    try {
        var iframe = $('#zbx_service iframe')[0];
        if (iframe && iframe.contentWindow && iframe.contentWindow.zbxClose) {
            iframe.contentWindow.zbxClose();
        }
    } catch(e) {}
    
    // 方法3：隐藏所有相关元素（备用方案）
    $("#zbx_service").hide();
    $("#zbx_service_icon").hide();
    $(".close-robot").hide();
    $("#zbx-drag-handle").hide();
}

// 打开智能客服
function robotShow() {
    // 尝试调用官方打开方法
    try {
        if (typeof zbxEmbed !== 'undefined' && zbxEmbed.openFrameModal) {
            zbxEmbed.openFrameModal();
        }
    } catch(e) {}
    
    $("#zbx_service").show();
    $("#zbx_service_icon").show();
    $(".close-robot").show();
    $("#zbx-drag-handle").show();
    updateDragHandle();
}

// 更新拖拽条位置（右侧留出50px避免遮挡关闭按钮）
function updateDragHandle() {
    var $win = $("#zbx_service");
    var $handle = $("#zbx-drag-handle");
    if ($win.length && $win.is(":visible") && $handle.length) {
        var rect = $win[0].getBoundingClientRect();
        $handle.css({
            top: rect.top + 'px',
            left: rect.left + 'px',
            width: (rect.width - 50) + 'px'  // 右侧留出50px，避免遮挡关闭按钮
        });
    }
}

// ========== 同步图标和关闭按钮的相对位置（右上角） ==========
function syncIconAndClosePosition() {
    var $icon = $("#zbx_service_icon");
    var $close = $(".close-robot");
    if (!$icon.length || !$close.length) return;
    
    var iconRect = $icon[0].getBoundingClientRect();
    
    // 关闭按钮在图标右上角
    var closeLeft = iconRect.right - $close.outerWidth() + 5;
    var closeTop = iconRect.top - $close.outerHeight() / 2;
    
    $close.css({
        left: closeLeft + 'px',
        top: closeTop + 'px',
        right: 'auto',
        bottom: 'auto'
    });
}

// ========== 拖拽状态 ==========
var dragType = null;

// 窗口拖拽数据
var winDrag = {
    active: false,
    startX: 0, startY: 0,
    startLeft: 0, startTop: 0
};

// 图标拖拽数据
var iconDrag = {
    active: false,
    startX: 0, startY: 0,
    startLeft: 0, startTop: 0,
    closeStartLeft: 0, closeStartTop: 0
};

// ========== 初始化窗口拖拽 ==========
function setupWindowDrag() {
    var $win = $("#zbx_service");
    if (!$win.length) return;
    
    var rect = $win[0].getBoundingClientRect();
    $win.css({
        left: rect.left + 'px',
        top: rect.top + 'px',
        right: 'auto',
        bottom: 'auto'
    });
    
    var $handle = $("#zbx-drag-handle");
    if (!$handle.length) {
        $handle = $('<div id="zbx-drag-handle"></div>');
        $('body').append($handle);
    }
    $handle.css({
        top: rect.top + 'px',
        left: rect.left + 'px',
        width: (rect.width - 50) + 'px',
        display: 'block'
    });
    
    $handle.off('mousedown').on('mousedown', function(e) {
        if (e.which !== 1) return;
        if (dragType === 'icon') return;
        
        e.preventDefault();
        e.stopPropagation();
        
        dragType = 'window';
        winDrag.active = true;
        winDrag.startX = e.clientX;
        winDrag.startY = e.clientY;
        
        var rect = $win[0].getBoundingClientRect();
        winDrag.startLeft = rect.left;
        winDrag.startTop = rect.top;
        
        $('body').css('user-select', 'none');
    });
}

// ========== 初始化图标拖拽 ==========
function setupIconDrag() {
    var $icon = $("#zbx_service_icon");
    var $close = $(".close-robot");
    if (!$icon.length || !$close.length) return;
    
    var iconRect = $icon[0].getBoundingClientRect();
    $icon.css({
        left: iconRect.left + 'px',
        top: iconRect.top + 'px',
        right: 'auto',
        bottom: 'auto'
    });
    
    syncIconAndClosePosition();
    $icon.css('cursor', 'move');
    
    $icon.off('mousedown').on('mousedown', function(e) {
        if (e.which !== 1) return;
        if (dragType === 'window') return;
        
        e.preventDefault();
        e.stopPropagation();
        
        dragType = 'icon';
        iconDrag.active = true;
        iconDrag.startX = e.clientX;
        iconDrag.startY = e.clientY;
        
        var iconRect = $icon[0].getBoundingClientRect();
        iconDrag.startLeft = iconRect.left;
        iconDrag.startTop = iconRect.top;
        
        var closeRect = $close[0].getBoundingClientRect();
        iconDrag.closeStartLeft = closeRect.left;
        iconDrag.closeStartTop = closeRect.top;
        
        $icon.addClass('dragging');
        $('body').css('user-select', 'none');
    });
}

// ========== 全局鼠标移动 ==========
$(document).on('mousemove', function(e) {
    // 窗口拖拽
    if (dragType === 'window' && winDrag.active) {
        var $win = $("#zbx_service");
        if (!$win.length) return;
        
        var dx = e.clientX - winDrag.startX;
        var dy = e.clientY - winDrag.startY;
        
        var newLeft = winDrag.startLeft + dx;
        var newTop = winDrag.startTop + dy;
        
        newLeft = Math.max(0, Math.min(newLeft, window.innerWidth - $win.outerWidth()));
        newTop = Math.max(0, Math.min(newTop, window.innerHeight - $win.outerHeight()));
        
        $win.css({ left: newLeft + 'px', top: newTop + 'px' });
        
        var $handle = $("#zbx-drag-handle");
        if ($handle.length) {
            $handle.css({ left: newLeft + 'px', top: newTop + 'px' });
        }
    }
    
    // 图标拖拽
    if (dragType === 'icon' && iconDrag.active) {
        var $icon = $("#zbx_service_icon");
        var $close = $(".close-robot");
        if (!$icon.length) return;
        
        var dx = e.clientX - iconDrag.startX;
        var dy = e.clientY - iconDrag.startY;
        
        var newIconLeft = iconDrag.startLeft + dx;
        var newIconTop = iconDrag.startTop + dy;
        
        newIconLeft = Math.max(0, Math.min(newIconLeft, window.innerWidth - $icon.outerWidth()));
        newIconTop = Math.max(0, Math.min(newIconTop, window.innerHeight - $icon.outerHeight()));
        
        $icon.css({ left: newIconLeft + 'px', top: newIconTop + 'px' });
        
        if ($close.length) {
            var newCloseLeft = iconDrag.closeStartLeft + dx;
            var newCloseTop = iconDrag.closeStartTop + dy;
            
            newCloseLeft = Math.max(0, Math.min(newCloseLeft, window.innerWidth - $close.outerWidth()));
            newCloseTop = Math.max(0, Math.min(newCloseTop, window.innerHeight - $close.outerHeight()));
            
            $close.css({
                left: newCloseLeft + 'px',
                top: newCloseTop + 'px'
            });
        }
    }
});

// ========== 全局鼠标松开 ==========
$(document).on('mouseup', function() {
    if (dragType === 'window') {
        winDrag.active = false;
        dragType = null;
        $('body').css('user-select', '');
        updateDragHandle();
    }
    
    if (dragType === 'icon') {
        iconDrag.active = false;
        dragType = null;
        var $icon = $("#zbx_service_icon");
        if ($icon.length) $icon.removeClass('dragging');
        $('body').css('user-select', '');
    }
});

// ========== 监听窗口大小变化 ==========
$(window).on('resize', function() {
    syncIconAndClosePosition();
    updateDragHandle();
});

// ========== 监听元素出现 ==========
var dragObserver = new MutationObserver(function() {
    if ($("#zbx_service").length) setupWindowDrag();
    if ($("#zbx_service_icon").length && $(".close-robot").length) setupIconDrag();
});

dragObserver.observe(document.body, {
    childList: true,
    subtree: true
});

// 立即执行
if ($("#zbx_service").length) setupWindowDrag();
if ($("#zbx_service_icon").length && $(".close-robot").length) setupIconDrag();

// 定时更新
setInterval(function() {
    if (dragType !== 'window') {
        updateDragHandle();
    }
    if (dragType !== 'icon') {
        syncIconAndClosePosition();
    }
}, 300);

// ========== 仲裁菜单悬浮效果 ==========
(function() {
    var li = document.getElementById('arbitrationLi');
    var div = document.getElementById('arbitrationDiv');
    if (!li || !div) return;

    var timer = null;

    function show() {
        if (timer) clearTimeout(timer);
        div.style.display = 'block';
    }

    function hide() {
        timer = setTimeout(function() {
            div.style.display = 'none';
        }, 80);
    }

    li.addEventListener('mouseenter', show);
    li.addEventListener('mouseleave', hide);
    div.addEventListener('mouseenter', show);
    div.addEventListener('mouseleave', hide);
})();

