    /**
     * 计算表单哈希值
     * @param {string} verificationId - 验证ID
     * @param {string} scene - 场景
     * @param {string} businessId - 业务ID
     * @param {string} mobile - 手机号
     * @returns {string} SHA-256哈希值的十六进制字符串
     */
    async function calculateFormHash(verificationId, scene, businessId, mobile) {
        try {
            // 拼接参数字符串（顺序必须固定）
            const content = verificationId + "|" + scene + "|" + businessId + "|" + mobile;
            console.log("content::", content)

            // 创建TextEncoder用于将字符串转换为UTF-8字节数组
            const encoder = new TextEncoder();
            const data = encoder.encode(content);

            // 使用Web Crypto API计算SHA-256哈希（异步）
            const hashBuffer = await window.crypto.subtle.digest('SHA-256', data);

            // 将ArrayBuffer转换为十六进制字符串
            const hashArray = Array.from(new Uint8Array(hashBuffer));
            const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
            console.log("hashHex::", hashHex)
            return hashHex;

        } catch (error) {
            console.error('计算formHash失败:', error);
            XWK.alert('计算表单哈希失败！', 'error');
        }
    }

