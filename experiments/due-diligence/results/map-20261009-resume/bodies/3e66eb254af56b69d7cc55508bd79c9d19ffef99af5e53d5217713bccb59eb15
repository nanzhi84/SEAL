    }
    
    // 绑定按钮事件
    this.bindButtonEvents();
  },
  
  // 启用无障碍模式
  enableAccessibility() {
    // 设置body标识
    document.body.setAttribute('data-accessibility-mode', 'true');
    localStorage.setItem('accessibilityMode', 'true');
    
    // 移除弹窗JS文件
    this.removeSpecificScripts();
    
    // 覆盖弹窗功能
    this.overridePopupFunctions();
    
    // 更新按钮样式
    this.updateButtonState(true);
    
    // 初始化无障碍工具
    if (typeof ariaTool === 'object' && typeof ariaTool.init === 'function') {
      ariaTool.init();
    }
    
    console.log('全站无障碍模式已启用');
  },
  
  // 禁用无障碍模式
  disableAccessibility() {
    // 移除body标识
    document.body.removeAttribute('data-accessibility-mode');
    localStorage.setItem('accessibilityMode', 'false');
    
    // 恢复原始弹窗功能
    this.restorePopupFunctions();
    
    // 恢复弹窗JS文件
    this.restoreScripts();
    
    // 更新按钮样式
    this.updateButtonState(false);
    
    console.log('无障碍模式已关闭');
  },
  
  // 移除弹窗JS文件
  removeSpecificScripts() {
    // 备份原始脚本路径
    if (!window._originalScripts) {
      window._originalScripts = [
        '/web2025/layer.js',
        '/web2025/my_layer.js'
      ];
    }
    
    // 移除脚本标签
    document.querySelectorAll('script[src]').forEach(script => {
      const src = script.src;
      if (window._originalScripts.some(path => src.includes(path))) {
        script.remove();
      }
    });
  },
  
  // 恢复弹窗JS文件
  restoreScripts() {
    if (!window._originalScripts) return;
    
    // 动态重新加载脚本
    window._originalScripts.forEach(path => {
      if (!document.querySelector(`script[src*="${path}"]`)) {
        const script = document.createElement('script');
        script.src = path;
        document.head.appendChild(script);
      }
    });
  },
  
  // 覆盖弹窗函数
  overridePopupFunctions() {
    // 确保layer对象存在
    window.layer = window.layer || {};
    
    // 备份原始方法
    if (!window._originalLayerFunctions) {
      window._originalLayerFunctions = {
        confirm: window.layer.confirm,
        alert: window.layer.alert,
        msg: window.layer.msg
      };
    }
    
    // 覆盖确认弹窗方法 - 直接放行
    window.layer.confirm = (content, options, yesCallback) => {
      if (typeof yesCallback === 'function') {
        yesCallback();
      }
      return false;
    };
    
    // 禁用其他弹窗方法
    window.layer.alert = window.layer.msg = () => {
      return false;
    };
  },
  
  // 恢复原始弹窗功能
  restorePopupFunctions() {
    if (!window._originalLayerFunctions) return;
    
    window.layer = window.layer || {};
    Object.assign(window.layer, window._originalLayerFunctions);
    
    // 清除备份
    delete window._originalLayerFunctions;
  },
  
  // 绑定按钮事件
  bindButtonEvents() {
    const button = document.getElementById('wza');
    if (!button) return;
    
    // 绑定点击事件
    button.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopImmediatePropagation();
      
      // 检查当前状态
      const isActive = document.body.hasAttribute('data-accessibility-mode');
      
      // 切换状态
      if (isActive) {
        this.disableAccessibility();
      } else {
        this.enableAccessibility();
      }
    });
  },
  
  // 更新按钮状态
  updateButtonState(isActive) {
    const button = document.getElementById('wza');
    if (!button) return;
    
    button.classList.toggle('accessibility-active', isActive);
  },
  
  // 添加视觉样式
  addVisualStyles() {
    const styleId = 'accessibility-styles';
    if (document.getElementById(styleId)) return;
    
    const style = document.createElement('style');
    style.id = styleId;
    // style.textContent = `
    //   #wza.accessibility-active {
    //     background-color: #4CAF50 !important;
    //     color: white !important;
    //     font-weight: bold;
    //     position: relative;
    //   }
    //   #wza.accessibility-active::after {
    //     content: '•';
    //     position: absolute;
    //     top: 3px;
    //     right: 3px;
    //     font-size: 10px;
    //   }
    // `;
    document.head.appendChild(style);
  }
};

// 页面加载时初始化
document.addEventListener('DOMContentLoaded', () => {
  GlobalAccessibility.init();
});

