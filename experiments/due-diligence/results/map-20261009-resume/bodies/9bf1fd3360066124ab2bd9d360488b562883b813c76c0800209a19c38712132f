<script> 
document.addEventListener('DOMContentLoaded', function() {
    const pillsTabs = document.querySelectorAll('#pillsTabs .nav-pills > li');
    const pillsContents = document.querySelectorAll('#pillsTabs .tab-pane');
   
    const initActive = () => {
        const activeTab = document.querySelector('#pillsTabs .nav-pills > li.active');
        const activeContent = document.querySelector('#pillsTabs .tab-pane.active');
        if (!activeTab && pillsTabs.length > 0) {
            pillsTabs[0].classList.add('active');
        }
        if (!activeContent && pillsContents.length > 0) {
            pillsContents[0].classList.add('active');
        }
    };
    initActive();

    pillsTabs.forEach(item => {
        item.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const tabId = this.querySelector('a').getAttribute('href').substring(1);
            
            pillsTabs.forEach(tab => tab.classList.remove('active'));
            pillsContents.forEach(content => content.classList.remove('active'));
            
            this.classList.add('active');
            const targetContent = document.getElementById(tabId);
            if (targetContent) {
                targetContent.classList.add('active');
            }
        });
    });
});

</script>
