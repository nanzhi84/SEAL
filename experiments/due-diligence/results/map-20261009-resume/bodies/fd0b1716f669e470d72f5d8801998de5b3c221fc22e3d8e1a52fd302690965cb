    //如果发布时间为两天以内的数据,加上new的图标
    var newIconHandle = function(announceDate) {
        //icon
        var icon = "";
        //系统当前时间
        var dateEnd = new Date();
        //发布时间
        var dateBegin = new Date(announceDate);
        //系统当前时间 - 发布时间,获取相差的毫秒数
        var dateDiff = dateEnd.getTime() - dateBegin.getTime();//时间差的毫秒数
        //发布时间距离当天有多少天
        var dayDiff = Math.floor(dateDiff / (24 * 3600 * 1000));//计算出相差天数
        //发布时间为两天以内
        if(dayDiff <= 2){
            //加上new的图片标记
            icon = "<img class='new' src='image/index/new.png'>";
        }
        return icon;
    }

