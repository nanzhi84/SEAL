			var dwmc = this.lastElementChild.name;
			var dwjjc = this.lastElementChild.value;
			var dwwz = this.lastElementChild.title;

			$("#appendDwmc").html(dwmc);
			$("#appendDwjjc").html(dwjjc);
			$("#appendYhid").val(yhid);
			$("#appendDwwz").html(dwwz);

			e.preventDefault();
			var mousePos = mousePosition(e);
			var  xOffset = 10;
			var  yOffset = 10;
			$(".append").addClass("on");
			$(".append").css("top",(mousePos.y - yOffset) + "px").css("left",(mousePos.x + xOffset) + "px");
		});

		//鼠标离开表格隐藏悬浮框
		$(".append").mouseleave(function(){
			$(this).removeClass('on')
		});
		$('div').not('.fd-unit').mouseenter(function(){
			$(".append").removeClass("on");
		})
	}

	//获取鼠标坐标
	function mousePosition(ev){
		ev = ev || window.event;
		if(ev.pageX || ev.pageY){
			return {x:ev.pageX, y:ev.pageY};
		}
		return {
			x:ev.clientX + document.body.scrollLeft - document.body.clientLeft,
			y:ev.clientY + document.body.scrollTop - document.body.clientTop
		};
	}

