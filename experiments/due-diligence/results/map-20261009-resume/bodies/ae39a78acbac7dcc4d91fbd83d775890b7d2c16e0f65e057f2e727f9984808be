<script>
    // 初始化位置和速度
    let x = 50, y = 50, xv = 2, yv = 1;
    const ad = document.getElementById("floating-ad");
    
    // 移动逻辑
    function moveAd() {
      const maxX = window.innerWidth - ad.offsetWidth;
      const maxY = window.innerHeight - ad.offsetHeight;
      
      if (x <= 0 || x >= maxX) xv *= -1;
      if (y <= 0 || y >= maxY) yv *= -1;
      
      x += xv;
      y += yv;
      ad.style.left = x + "px";
      ad.style.top = y + "px";
    }
    
    // 定时移动
    let moveInterval = setInterval(moveAd, 50);
    
    // 关闭按钮
    document.getElementById("close-btn").onclick = () => {
      ad.style.display = "none";
    };
    
    // 悬停控制
    ad.onmouseover = () => clearInterval(moveInterval);
    ad.onmouseout = () => moveInterval = setInterval(moveAd, 50);
  </script>
