<script>
  var str = $(".visits span").eq(0).text();
  if(str!==undefined &&  str.slice(5,9)<=2020){
var replaceUrl = function (elment, attrs) {
	elment.each(function () {
		var targrt = $(this).attr(attrs);
		var url = '';
		//特殊处理域名
		if (targrt.indexOf("dnr.sc.gov.cn:81") > -1 && attrs == "src") {
			var url = targrt.replace("dnr.sc.gov.cn:81", "202.61.89.138:81");
			 $(this).attr(attrs, url);
			 targrt = url;
		}
		if (targrt.indexOf('http://gtzyj.luzhou.gov.cn') > -1){
			var url = targrt.replace("http://gtzyj.luzhou.gov.cn", "http://zrzyhghj.luzhou.gov.cn");
			 $(this).attr(attrs, url);
			 targrt = url;
		}
	
		//特殊路径匹配
		var reg = /http\:[\/]+(default|@)/
		if (targrt.indexOf("http://http://") > -1) {
		
			url = targrt.replace("http://http://", "http://");
			$(this).attr(attrs, url);
		
			//特换域名
		} else if (targrt.indexOf("http://") > -1) {
			if ((targrt.indexOf('http:///scdnr') > -1) ||
				(targrt.indexOf('http://scdnr') > -1)) {
				url = targrt.replace(/http\:[\/]+scdnr/, "/scdnr");
				$(this).attr(attrs, url);
			}
		
			//特殊路径
			if (reg.test(targrt)) {
				targrt.replace(/http\:[\/]+(default|@)/, (item)=>{
					var str = item.substr(item.lastIndexOf('/'));
					url = targrt.substr(targrt.indexOf(str));
					return url;
				})
				$(this).attr(attrs, url);
			}
		} else if (targrt.indexOf("http://") == -1) {
			if (targrt.indexOf('dnr.sc.gov.cn') > -1) {
				url = "http://" + targrt;
				$(this).attr(attrs, url);
			}
		}
	});
}

