/**
 * 控制地质灾害预警相关元素显示/隐藏及地图图片加载
 * @param {boolean} showMap - true：显示#map，隐藏#dzzh；false：隐藏#map，显示#dzzh（#zxdc始终显示）
 */
function controlGeologicalWarning(showMap) {
    // 1. 基础DOM元素控制：#zxdc始终显示，根据showMap控制#map和#dzzh
    $("#zxdc").removeClass('dn'); // #zxdc保持一直显示，确保移除隐藏类
    const $map = $("#map");
    const $dzzh = $("#dzzh");
    const $yjzj = $("#yjzj");

    if (showMap) {
        // 显示map：显示#map和#yjzj，隐藏#dzzh
        $yjzj.removeClass('dn');
        $dzzh.addClass('dn');
        $map.removeClass('dn');

        // 2. 日期处理（移除小于10补0逻辑）
   const currentDate = new Date();
            let year = currentDate.getFullYear();
            let yy = year.toString().substr(2, 2);

            // 单独数字月份 用来计算
            let monthNum = currentDate.getMonth() + 1;
            // 最后展示用的两位月份字符串
            let m = monthNum.toString().padStart(2, '0');

            const h = currentDate.getHours();
            const dt = currentDate.getDate().toString().padStart(2, '0');

            // 昨天日期也补零
            const yesterday = new Date(currentDate.getTime() - 86400000);
            const d = yesterday.getDate().toString().padStart(2, '0');

            if (h < 18) {
                if (dt === '01') {
                    // 只用数字变量减，不乱格式
                    monthNum--;
                    // 跨年1月变12月
                    if (monthNum < 1) {
                        monthNum = 12;
                        year -= 1;
                        yy = year.toString().substr(2, 2);
                    }
                    // 重新生成带0的月份字符串
                    m = monthNum.toString().padStart(2, '0');
                }
            }

            let targetDate = h < 18 ? d : dt;
            const mapImgUrl = "http://mh.icdnrsc.net/Admin_Models/DZYJ/DZimg/DZZH" + yy + m + targetDate + "20.gif";
        // 设置地图图片src
        $map.find("img").attr("src", mapImgUrl);
    } else {
        // 不显示map：隐藏#map和#yjzj，显示#dzzh
        $yjzj.addClass('dn');
        $dzzh.removeClass('dn');
        $map.addClass('dn');
    }
}



// 1. 显示#map（隐藏#dzzh，#zxdc始终显示）
controlGeologicalWarning(true);

