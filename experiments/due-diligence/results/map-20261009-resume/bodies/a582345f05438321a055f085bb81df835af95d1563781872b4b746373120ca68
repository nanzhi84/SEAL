               if(exceptionStatus=='1'){
                   return "中止";
               }else if(exceptionStatus=='3'){
                   return "终结";
               }else if(exceptionStatus=='4'){
                   return "流拍";
               }else if(exceptionStatus=='5'){
                   return "异常结束";
               }
           }else{
               if(mainStatus==0){
                   return "录入中";
               }else if(mainStatus==10){
                   return "审核中";
               }else if(mainStatus==1){
                   return "退回";
               }else if(mainStatus==2){
                   return "已撤回";
               }else if(mainStatus==5){
                   return "待认领";
               }else if(mainStatus==30){
                   return "挂牌中";
               }else if(mainStatus==40){
                   return "等待竞价";
               }else if(mainStatus==70){
                   return "竞价中";
               }else if(mainStatus>=79 && mainStatus<100){
                   return "已成交";
               }else if(mainStatus==100){
                   return "已归档";
               }
           }

       }
