<script>
    // ==================== 登记意向弹窗（侧边栏公共版，自包含，不依赖页面已有脚本） ====================
    var siderLeadChooseIndex = 0;
    var siderLeadFormIndex = 0;
    // 弹窗内容缓存（初始化时从源节点取出并移除源节点，保证表单 id 在页面中唯一）
    var siderLeadPopHtml = { choose: '', reg: '', inv: '' };

    $(function() {
        siderLeadPopHtml.choose = $('#siderLeadChoosePop').html() || '';
        siderLeadPopHtml.reg = $('#siderLeadRegisterPop').html() || '';
        siderLeadPopHtml.inv = $('#siderLeadInvestPop').html() || '';
        $('#siderLeadChoosePop, #siderLeadRegisterPop, #siderLeadInvestPop').remove();
    });

    // 入口：未加载 layer.js 的页面按需懒加载后再打开
    // 注意：layer.js 动态加载时无法通过 document.scripts 定位自身目录（最后一个 script 是 body 里的内联脚本），
    // 导致它的默认样式 theme/default/layer.css 不会被自动加载，弹窗会以无样式状态插到页面底部看不见，
    // 所以这里必须手动补一份样式表。
    function siderLeadChoose() {
        if (typeof window.layer !== 'undefined') {
            siderLeadOpenChoose();
        } else {
            siderLeadLoadCss();
            $.getScript('/zbxUI/js/layer/layer.js', function() {
                siderLeadOpenChoose();
            });
        }
    }

    // 补载 layer 默认样式（幂等，只插一次）
    function siderLeadLoadCss() {
        if (document.getElementById('siderLeadLayerCss')) return;
        var link = document.createElement('link');
        link.id = 'siderLeadLayerCss';
        link.rel = 'stylesheet';
        link.href = '/zbxUI/js/layer/theme/default/layer.css';
        document.head.appendChild(link);
    }

    // 打开意向选择弹窗
    function siderLeadOpenChoose() {
        siderLeadChooseIndex = layer.open({
            type: 1,
            title: '登记意向',
            area: ['560px', 'auto'],
            content: siderLeadPopHtml.choose
        });
    }

    // 打开对应表单弹窗
    function siderLeadOpenForm(type) {
        layer.close(siderLeadChooseIndex);
        if (type == 'zs') {
            siderLeadFormIndex = layer.open({
                type: 1,
                title: '我要登记（资产转让）',
                area: ['600px', 'auto'],
                content: siderLeadPopHtml.reg
            });
        } else {
            siderLeadFormIndex = layer.open({
                type: 1,
                title: '我要投资（资产收购）',
                area: ['600px', 'auto'],
                content: siderLeadPopHtml.inv
            });
        }
    }

    // 校验轻提示（zIndex 置顶，保证显示在弹窗之上而不被遮挡）
    function siderLeadTip(msg, icon) {
        layer.msg(msg, { icon: icon || 2, time: 2200, zIndex: 999999999 });
    }

    // 提交意向表单（传表单id，由框架统一serialize提交，避免中文二次编码）
    function siderLeadSubmit(type) {
        var formId = (type == 'zs') ? 'siderLeadRegisterForm' : 'siderLeadInvestForm';
        var $form = $('#' + formId);
        var contactName = $.trim($form.find("input[name='contactName']").val());
        var phone = $.trim($form.find("input[name='phone']").val());
        var assetType = $.trim($form.find("input[name='assetType']").val());

        if (contactName == '') {
            siderLeadTip('请输入公司名称/个人姓名');
            return;
        }
        if (phone == '') {
            siderLeadTip('请输入联系电话');
            return;
        }
        if (assetType == '') {
            siderLeadTip(type == 'zs' ? '请输入转让资产类型' : '请输入意向购买类型');
            return;
        }

        if (type == 'zs') {
            var reviveWays = [];
            $form.find(".lead-checkbox input[type='checkbox']:checked").each(function() {
                reviveWays.push($(this).val());
            });
            if (reviveWays.length == 0) {
                siderLeadTip('请选择盘活方式');
                return;
            }
            var areaText = $.trim($form.find("input[name='areaText']").val());
            if (areaText == '') {
                siderLeadTip('请输入标的所在地');
                return;
            }
            // 勾选项以英文逗号拼为单个参数，随表单序列化提交
            $form.find("input[name='reviveWays']").remove();
            $('<input type="hidden" name="reviveWays">').val(reviveWays.join(',')).appendTo($form);
        } else {
            var investAmount = $.trim($form.find("input[name='investAmount']").val());
            if (investAmount == '') {
                siderLeadTip('请输入意向投资金额');
                return;
            }
        }

        apiPost('/web/addLead', formId, function(res) {
            if (res && res.result == 'T') {
                layer.closeAll();
                siderLeadTip('提交成功，我们将尽快与您联系！', 1);
            } else {
                siderLeadTip((res && res.message) || '提交失败，请稍后重试');
            }
        });
    }
</script>
