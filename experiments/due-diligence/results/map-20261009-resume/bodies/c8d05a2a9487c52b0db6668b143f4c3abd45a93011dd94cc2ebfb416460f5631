    function vueData(data) {
      Vue.set(vm.results, "items", data.item);
      Vue.set(vm.results, "date", data.date);
    }

    $(function () {
      vm = new Vue({
        el: "#result-content",
        data: datas,
        computed: {
          ie9: function () {
            if (
              navigator.appName == "Microsoft Internet Explorer" &&
              parseInt(
                navigator.appVersion
                  .split(";")[1]
                  .replace(/[ ]/g, "")
                  .replace("MSIE", "")
              ) <= 9
            ) {
              return true;
            }
            return false;
          }
        },
        methods: {
          reHeight: function () {
          },
          search: function () {
            if (this.validParams() && this.validCaptcha()) {
              var url = "/dataService/WebService.asmx/getMarkspaceData";

              openModel();

              $.ajax({
                url: url,
                data: datas.params,
                                            type: 'POST',
                dataType: "json", //返回数据格式，默认json
                success: function (data) {
                  closeModel();
                  Vue.set(vm.results, "items", []);
                  if (data.result_code == "100") {
                    vueData(data);
                    vm.params.code = "";
                  } else if (data.result_code == "101") {
                    openAlert("未找到对应数据，请核对搜索条件后再试。");
                  } else if (data.result_code == "200") {
                    openAlert("搜索条件错误，请核对搜索条件后再试。");
                  } else if (data.result_code == "300") {
                    openAlert("验证码错误，请核对验证码后再试。");
                  }
                  $("#verifyImg").click();
                },

                fail: function (data) {
                  closeModel();
                  openAlert("搜索失败，请检查网络状态或者稍后再试。");
                  $("#verifyImg").click();
                },

                error: function (data) {
                  closeModel();
                  openAlert("搜索失败，请检查网络状态或者稍后再试。");
                  $("#verifyImg").click();
                }

              });
              this.params.code = "";
            }
          },
          validParams: function () {
            if (this.params.name != "" && this.params.province != '' && this.params.code != "") {
              return true;
            } else {
              openAlert("搜索条件和验证码均不能为空，请核对搜索条件后再试。");
              return false;
            }
          },
          validCaptcha: function () {
              return true;
            var code = checkCode(this.params.code);
            if (code == 0 || code == 2) {
              openAlert("验证码错误，请重新输入");
              $("#verifyImg").click();
              //this.params.code = "";
              return false;
            }
            return true;
          },
          emptyParams: function () {
            this.params.name = "";
            this.params.province = "";
            this.params.code = "";
            this.results.items=[];
            $("#verifyImg").click();
          },
          keyDown: function () {
            if (window.event.keyCode == 13) {
              this.search();
            }
          }
        }
      });
    });
  </script>
