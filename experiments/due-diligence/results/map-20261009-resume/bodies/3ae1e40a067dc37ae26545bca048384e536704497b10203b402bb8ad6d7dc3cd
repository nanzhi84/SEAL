  <script>
    $(function () {
      // 视频
      var ObjPlayVideo = document.getElementById("play-video")
      var video = document.getElementById("video");
      var ObjVideoBox = document.getElementById("videobox");

      function getRequest() {
        var url = decodeURIComponent(location.search)
        var theRequest = new Object()
        if (url.indexOf("?") != -1) {
          var str = url.substr(1)
          var strs = str.split("&")
          for (var i = 0; i < strs.length; i++) {
            theRequest[strs[i].split("=")[0]] = unescape(strs[i].split("=")[1])
          }
        }
        return theRequest
      }

      // 声音控件里的声音
      var JQsound = $("#sound")

      // 倒计时中的秒
      var JQsecond = $("#second")

      // 视频自适应宽高===开始======================
      adaptiveLayout()

      // // 窗口大小发生改变时，视频宽高也改变
      $(window).resize(function () {
        _adaptiveLayout()
      })

      function _adaptiveLayout() {
        debounce(adaptiveLayout, 500)()
      }

      // 视频自适应宽高
      var JQWindow = $(window)
      var ObjVideoBox = document.getElementById("videobox");

      function adaptiveLayout() {

        // 获取视窗的 宽、高
        var JQWindow = $(window)
        var bodyWidth = JQWindow.width() - 10
        var bodyHeight = JQWindow.height()
        if (ObjVideoBox == null) return;

        if (bodyHeight * (16 / 9) > bodyWidth) {
          ObjVideoBox.style.width = bodyWidth + "px"
          ObjVideoBox.style.height = bodyWidth / (16 / 9) + "px"
        } else {
          ObjVideoBox.style.height = bodyHeight + "px"
          ObjVideoBox.style.width = bodyHeight * (16 / 9) + "px"
        }

      }
      // 视频自适应宽高===结束===================================

      // onRobot 用于区分在立案机器人打开的官网, 不播放开屏视频
      var urlParams = getRequest()
      if (Object.keys(urlParams).length > 0) {
        if (urlParams.onRobot === '1') {
          sessionStorage.setItem("hasWatchedTheVideo", true);
          sessionStorage.setItem("onRobot", "1");
        }
      }
      // 第一次进来就播放视频
      var hasWatchedTheVideo = sessionStorage.getItem("hasWatchedTheVideo");

      if (hasWatchedTheVideo === null) {
        // 样式报错
        // playVideo()
      }

      // 封装播放视频 方法
      function playVideo() {
        // 隐藏滚动条（js）
        document.body.style.overflow = "hidden";

        sessionStorage.setItem("hasWatchedTheVideo", true);

        ObjPlayVideo.style.height = JQWindow.height() + "px"

        $("#play-video").show()


        // 视频加载完，才显示 视频相关的元素（声音，倒计时）
        $("#video").on("play", function (e) {
          // 倒计时关闭，声音控件
          $("#closeBtn, #sound").show()

          // 25秒倒计时后关闭视频
          Countdown(25)
        });

        $("#video").on("timeupdate", function (e) {
          // 个别浏览器首次无法显示声音与倒计时按钮, 添加监听以重新显示
          if ($("#closeBtn").css("display") === "none") {
            $("#closeBtn, #sound").show()
          }
        });


        // 25秒倒计时后关闭视频
        Countdown(25)
      }

      // 倒计时函数的 定时器
      var timer = null
      // 倒计时函数
      function Countdown(n) {
        if (timer !== null) {
          clearInterval(timer)
          timer = null
        }

        // n秒
        var i = n;
        after()
        function after() {
          if (i >= 0) {
            JQsecond.empty().append(i);
            i = i - 1;
            timer = setTimeout(function () {
              after();
            }, 1000);
          }
        }
      }

      $("#playBtn").on("click", function () {
        replayVideo()
      });
      $("#robotApp").on("click", function () {
        // window.open('https://new.gzac.org/robotWelcome/robot-welcome.html', "_blank");
        window.open('https://new.gzac.org/robotWelcome', "_blank");
        event.stopPropagation(); //  阻止事件冒泡
      });

      // 关闭 官网开屏视频
      $("#closeBtn").click(function () {
        if (timer !== null) {
          clearInterval(timer)
          timer = null
        }

        var JQvideobox = $("#videobox")
        var JQvideo = $("#video")
        JQvideobox.addClass("flipOutY")
        JQvideobox.slideToggle();
        $("#closeBtn, #videobox_bg, #sound").hide()

        JQvideo.trigger('pause')

        // 停止视频播放，归零
        video.currentTime = 0

        ObjPlayVideo.style.height = 0

        // 显示滚动条（js）
        document.body.style.overflow = "auto";

      })


      // 切换声音、静音
      JQsound.click(function () {
        JQsound.toggleClass("sound-play");
        var sta = video.muted;
        if (sta === true) {
          video.muted = false;
        } else {
          video.muted = true;
        }
      })

      // 视频播放完就关闭
      $("#video").on("ended", function () {
        $("#closeBtn").click()
      })

      function _replayVideo() {
        debounce(replayVideo, 300)
      }

      // 重播视频
      function replayVideo() {

        var JQvideobox = $("#videobox")
        JQvideobox.removeClass("flipOutY")

        // 隐藏滚动条（js）
        document.body.style.overflow = "hidden";

        // 视频播放容器的高度等于视窗的高度
        ObjPlayVideo.style.height = JQWindow.height() + "px"

        // 所有视频播放容器的所有元素显示
        $("#play-video, #closeBtn, #videobox_bg, #sound, #videobox").show()

