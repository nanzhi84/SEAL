            var url = this.urlList[areaCode];
            if(!url) {
                $.info("该地区尚未开通此项服务");
                return;
            }

            $('.map-cont .btn-selected').removeClass('btn-selected');
            $(obj).addClass('btn-selected');
            // var otherWindow = window.open();
            // otherWindow.opener = null;
            // otherWindow.location = url;
            $.open_new_window(url);
            //var el = document.getElementById("toOpen");
