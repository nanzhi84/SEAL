        }
    };

    $(function () {
        // 浏览器滚动侧边悬浮栏返回顶部按钮显示隐藏
        $(window).scroll(function () {
            if ($(window).scrollTop() > 100) {
                $('.fixed-window').css('height', '388px');
                $('.fixed-window .top-btn').show();
            } else {
                $('.fixed-window').css('height', '332px');
                $('.fixed-window .top-btn').hide();
            }
        });

        // 加载各省平台连接
        $.ajax({
            url: '/sscx/taxpayer/url',
            type: 'post',
            dataType: 'json',
            success: function (res) {
                if(res.code === 0) {
                    return;
                }

                var mapList = res.data;
                var urlObj = {};

                for(var i=0; i<mapList.length; i++) {
                    urlObj[mapList[i].SSSWJGID] = mapList[i].LJDZ;
                }

                tax_payer.urlList = urlObj;
            }
        });

        // 点击事件
        $('.con').on('click', 'a', function () {
            tax_payer.search(this);
        })
    })
</script>
