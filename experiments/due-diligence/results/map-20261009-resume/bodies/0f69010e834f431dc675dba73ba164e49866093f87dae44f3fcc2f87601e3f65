<script>
    layui.use(function() {
        let element = layui.element,
            form = layui.form,
            upload = layui.upload,
            $ = layui.jquery;

        // 切换搜索类型
        $('.recommend a').click(function(){
            $('.recommend a').removeClass('on');
            $(this).addClass('on');
            const type = $('a.on').attr('data-type')
            switch_hot_content(type);
        });

        // 搜索关键词
        $('.search_btn').click(function(){
            const type = $('a.on').attr('data-type')
            const keywords = $("input[name=keywords]").val()
            if(!keywords){
                return false;
            }
            let url = ''
            if(type === 'institution'){
                url += "/index/institution/index.html?keywords="+keywords;
            }else if(type === 'arbitrator'){
                url += "/index/arbitrator/index.html?keywords="+keywords;
            }else if(type === 'rule'){
                url += "/index/rule/index/keyword/"+keywords;
            }else if(type === 'treatise'){
                url += "/index/treatise/index.html?keywords="+keywords;
            }else{
                url += "/index/book/index.html?keywords="+keywords;
            }
            window.location.href = url;
        });

        // 切换热门内容
        function switch_hot_content(type){
            var data = {};
            data.type = type;
            data.num = 5;
            $.ajax({
               url:"/index/index/hot_content.html",
               data:data,
               dataType:"json",
               type:"post",
               success:function(mes){
                   let hotDom = $('.hot')
                   hotDom.empty();
                   if(mes.length > 0){
                       var html = '<div class="tit">热门：</div>';
                       for(var i=0;i<mes.length;i++){
                           if(type === 'institution'){
                               html += '<a href="/index/institution/detail.html?id='+mes[i].id+'">';
                           }else if(type === 'arbitrator'){
                               html += '<a href="/index/arbitrator/detail.html?id='+mes[i].id+'">';
                           }else if(type === 'rule'){
                               html += '<a href="/index/rule/detail/id/'+mes[i].id+'">';
                           }else if(type === 'treatise'){
                               html += '<a href="/index/treatise/index.html?id='+mes[i].id+'">';
                           }else{
                               html += '<a href="/index/book/detail.html?id='+mes[i].id+'">';
                           }
                           html += mes[i].title+'</a>';
                       }
                       hotDom.html(html);
                   }
               }
            });
        }

        switch_hot_content('book');


