    <script type="text/javascript">
      var xPos = 0 //document.body.clientWidth-20
      var yPos = 0 //document.body.clientHeight/2
      var step = 1
      var delay = 40
      var height = 0
      var Hoffset = 0
      var Woffset = 0
      var yon = 0
      var xon = 0
      var pause = true
      var interval
      var floatWindowEl = document.getElementById('floatWindow')

      function changePos() {
        width = document.body.clientWidth
        height = document.body.clientHeight
        Hoffset = floatWindow.offsetHeight
        Woffset = floatWindow.offsetWidth
        floatWindow.style.left = (xPos + document.body.scrollLeft + document.documentElement.scrollLeft) + 'px'
        floatWindow.style.top = (yPos + document.body.scrollTop + document.documentElement.scrollTop) + 'px'

        if (yon) {
          yPos = yPos + step
        }
        else {
          yPos = yPos - step
        }

        if (yPos < 0) {
          yon = 1
          yPos = 0
        }

        if (yPos >= (height - Hoffset)) {
          yon = 0
          yPos = (height - Hoffset)
        }

        if (xon) {
          xPos = xPos + step
        }
        else {
          xPos = xPos - step
        }

        if (xPos < 0) {
          xon = 1
          xPos = 0
        }

        if (xPos >= (width - Woffset)) {
          xon = 0
          xPos = (width - Woffset)
        }
      }

      function start() {
        floatWindow.visibility = 'visible'
        interval = setInterval('changePos()', delay)
      }


      if (floatWindowEl) {
        floatWindowEl.onmouseover = function () {
          clearInterval(interval)
          interval = null
        }

        floatWindowEl.onmouseout = function () {
          interval = setInterval('changePos()', delay)
        }

        floatWindowEl.style.top = yPos
        start()
      }
    </script>



