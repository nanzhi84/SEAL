			$('.tab-title div>a').click(function () { 
					$('.tab-title div>a').removeAttr('m-href');
			}) 
	}else { 
			$('.tab-title div a').each(function () { 
					var href=$(this).attr("m-href"); 
					$(this).attr('href', href);
			}) 
			
		}	
		
		$(function () { 
    $.fn.extend({
        removeRight: function() {
            for(var i=0;i<=this.length;i++){
                if(i%2 == 0&&i!=0){
                    this.eq(i-1).css('margin-right','0');
                }
            }
        }
    });
    $(".zmhd-content li").removeRight();
})
	</script>
