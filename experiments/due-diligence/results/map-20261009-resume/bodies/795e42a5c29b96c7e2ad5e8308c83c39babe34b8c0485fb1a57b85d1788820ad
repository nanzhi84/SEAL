            success: function (data) { //成功后执行的函数在、
                zNodes = data.list;
                treeInit(data);
            },
            error: function (error) {
                console.log(error)
            }
        });
    }

    // ztree添加滚动条样式
    var zTree;
    function resizeScroll() {
        setTimeout(function () {
            $('#ztree').getNiceScroll().resize();
        }, 100)
    }
    // ztree获取节点展示的箭头
    function getTrangle(treeNode) {
        setTimeout(function () {
            if (treeNode.children) {
                var nodes = treeNode.children;
                for (var i = 0; i < nodes.length; i++) {
                    if (nodes[i].haveChildren) {
                        $('#' +
                            nodes[i].tId).addClass('fd-haveChildNode');
                    }
                }
                getTrangleStyle()
            }
        }, 100)
    }
    // ztree节点样式调整
    var setting = {
        view: {
            dblClickExpand: false,
            showLine: false,
            selectedMulti: true,
            expandSpeed: 0
        },
        data: {
            simpleData:{
                enable:false, 
            }
        },
        callback: {
            beforeClick: function (treeId, treeNode, eventNode) {
                var zTree = $.fn.zTree.getZTreeObj("ztree");
                var base = "";
                if (!treeNode.children) {
                    $.ajax({
                        type: "GET", //方式
                        url: base+"/getOrganTree.jspx?fyId=" + treeNode.id +"&siteId="+10, //路径
                        dataType: "json",
                        success: function (data) { //成功后执行的函数在、
                            zTree.addNodes(treeNode, data.children)
                            getTrangle(treeNode)
                        }
                    });
                }
                getTrangle(treeNode)
                 if (treeNode.isParent) {
                    var bq = eventNode.originalEvent.srcElement.tagName;
                    if (bq === 'SPAN') {
                      eventNode.originalEvent.srcElement.parentNode.previousSibling.click()
                    } else {
                      eventNode.originalEvent.srcElement.previousSibling.click()
                    }
                    resizeScroll();
                    return false;
                } else {
                   resizeScroll();
                    return true;
                }
            },
        }
    };
    //初始化ztree
    function treeInit(data) {
        var t = $("#ztree");
        t = $.fn.zTree.init(t, setting, data.list);
        var zTree = $.fn.zTree.getZTreeObj("ztree");
        setTimeout(function () {
            var treeNode = zTree.getNodeByTId('ztree_1')
            getTrangle(treeNode)
        }, 200)
        $("#ztree").niceScroll({
            cursorcolor: "#efa29d", // cursoropacitymax: 0.7, // boxzoom: true, // touchbehavior: true });
        });
    }
</script>
