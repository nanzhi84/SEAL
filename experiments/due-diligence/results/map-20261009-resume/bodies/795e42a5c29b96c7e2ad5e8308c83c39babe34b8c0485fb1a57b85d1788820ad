    //ztree调取本地json数据
    function getTreeData(name) {
        var treename;
        if (name == 'china') {
            treename = 'tree';
        } else {
            treename = name
        }
        var base = "";
        $.ajax({
            type: "GET", //方式
            url: base+"/getOrganTree.jspx?siteId="+10, //路径
