        $.ajax({
            url: "/deviceField.html",
            type: "post",
            dataType: "json",
            success: function (data) {
                //返回json对象集合
                var list = [];
                list = data.ZDJH;
                var obj1 = {};
                for (var i = 0; i < list.length; i++){
                    var variableName = list[i].CONFIG_NAME;
                    var humanReadable = list[i].CONFIG_NAME_CN;
                    var obj = {
                        "humanReadable": humanReadable,
                        "variableName": variableName,
                        "searchType": list[i].CONFIG_VALUE
                    };
                    obj1[variableName] = obj;
                }
                optionsObj = {"options": obj1};
                for (var k in optionsObj.options) {
                    element = optionsObj.options[k]
                    if (element.variableName == 'groupSection') {
                        firstAdvField.append('<option disabled value="' + element.variableName + '">' + element.humanReadable + '</option>');
                    } else {
                        firstAdvField.append('<option searchType="' + element.searchType + '" limitedoptions="' + element.limitedOptions + '" value="' + element.variableName + '">' + element.humanReadable + '</option>');
                    }
                }
            },
            error: function (data) {

            }
        });
        $('.advField').change(selectChangeListener);

        applyInputListener();
    })
    //增加行
    //var flag = 1;
    function addRow() {
        //Only one row, remove the minus
        if ($('.query-input').length == 1) {
            var $newMinusButton = $('<a class="els-delete" onclick="deleteRow(this)">-</a>');
            $newMinusButton.click(function () {
                deleteRow(this);
            });
            $('.query-input').first().find('.control-buttons').append($newMinusButton);

        }
        //当行数大于等于5时，返回
        if ($('.query-input').length >= 5) {
            return;
        }
        $newRow = $(rowHtml);
        var firstAdvField = $newRow.find('.advField');

        for (var k in optionsObj.options) {
            element = optionsObj.options[k]
            // If section header
            if (element.variableName == 'section') {
                firstAdvField.append('<option disabled value="' + element.variableName + '">' + element.humanReadable + '</option>');
            }
            // Actual options
            else {
                firstAdvField.append('<option searchType="' + element.searchType + '" limitedoptions="' + element.limitedOptions + '" value="' + element.variableName + '">' + element.humanReadable + '</option>');
            }
        }
        $newRow.find('.els-delete').click(function () {
            deleteRow(this);
        });

        $newRow.hide();
        var rowLength = $("#table tr").length;
        $("#queryTable tr:eq(" + (rowLength - 1) + ")").after($newRow);
        $newRow.slideToggle('fast');
        applyInputListener();
        buildQuery();
        buildQueryChinese();
        $('#add-row').detach().appendTo('.queryRows.query-input:last-child .control-buttons');
    }

    //删除行
    function deleteRow(button) {
        // Find the row that this is a part of
        var $closestRow = $(button).closest('.query-input');
        //只有最后两行时
        if ($('.query-input').length == 2) {
            if ($closestRow.is(':last-child')) {
                $('.query-input').first().find('.els-delete').remove();
            }
            else {
                $('.query-input').last().find('.els-delete').remove();
            }
        }
        if ($closestRow.hasClass('first')) {
            $closestRow.next(".queryRows").addClass('first').find('.SearchTool').remove();
        } else if ($closestRow.is(':last-child')) {
            $('#add-row').detach().appendTo($closestRow.prev().find('.control-buttons'));
        }
        $closestRow.slideUp("fast", function () {
            $(this).remove();
        });

        $closestRow.remove();

        applyInputListener();
        //
        buildQuery();
        buildQueryChinese();


    }

    //构建拼接查询条件
    function buildQuery() {
        var emptyQueryPresent = false;
        var firstHasText = true;
        var full_queryString = "";
        //无查询条件则不执行操作
        if (!($('#advancedSearch').find('.queryRows.query-input').length)) {
            return false;
        }
        //遍历验证并或者查询条件相关数据
        $('#advancedSearch').find('.queryRows.query-input').each(function (index) {

            if (index == 0 && $(this).find(".queryContent").val() == '') {
                firstHasText = false;
                return;
            } else if ($(this).find(".queryContent").val() == '') {
                return;
            }

            var queryString = "";

            if ($(this).find('.SearchTool').length > 0) {
                if (full_queryString != "") {
                    queryString += $(this).find('.SearchTool').val() + " ";
                }
            }

            var wrappedTerm = ""
            var searchType = $(this).find('.advField').find('option:selected').attr('searchType');
            var allSearch = ($(this).find('.advField').val() == 'all');

            if (!allSearch) {
                queryString += $(this).find('.advField').val() + ":";
            }
            if ($(this).find('.SearchFor').length) {
                if (allSearch) {
                    queryString += '(';
                }
                // If we're working with a date
                if (searchType == 'date') {
                    if ($(this).find('.SearchFor').val() == 'on') {
                        queryString += '([' + $(this).find(".queryContent").val() + "])";
                    } else if ($(this).find('.SearchFor').val() == 'before') {
                        queryString += '([* TO ' + $(this).find(".queryContent").val() + '])';
                    } else if ($(this).find('.SearchFor').val() == 'after') {
                        queryString += '([' + $(this).find(".queryContent").val() + ' TO *])';
                    } else if ($(this).find('.SearchFor').val() == 'between') {
                        var advQueries = $(this).find(".queryContent");
                        if ($(advQueries).length == 2 && ($(advQueries[1]).val() != null && $(advQueries[1]).val() != "")) {
                            queryString += '([' + $(advQueries[0]).val() + ' TO ' + $(advQueries[1]).val() + '])';
                        } else {
                            queryString += $(this).find(".queryContent").val();
                        }
                    } else {
                        queryString += $(this).find(".queryContent").val();
                    }

                } else {

                    if (!allSearch) {
                        queryString += "(";
                    }

                    //等于
                    if ($(this).find('.SearchFor').val() == '1') {
                        wrappedTerm = '"' + $(this).find(".queryContent").val() + '"';
                    }//开头是
                    else if ($(this).find('.SearchFor').val() == '2') {
                        wrappedTerm = $(this).find(".queryContent").val() + '*';
                    }//开头不是
                    else if ($(this).find('.SearchFor').val() == '3') {
                        wrappedTerm = $(this).find(".queryContent").val() + '@';
                    }//结尾是
                    else if ($(this).find('.SearchFor').val() == '4') {
                        wrappedTerm = '*' + $(this).find(".queryContent").val();
                    }//结尾不是
                    else if ($(this).find('.SearchFor').val() == '5') {
                        wrappedTerm = '@' + $(this).find(".queryContent").val();
                    }//包含
                    else if ($(this).find('.SearchFor').val() == '6') {
                        wrappedTerm = '*' + $(this).find(".queryContent").val() + '*';
                    }//不包含
                    else if ($(this).find('.SearchFor').val() == '7') {
                        //等于
                        wrappedTerm = '@' + $(this).find(".queryContent").val() + '@';
                    }
                    queryString += wrappedTerm;
                    if (!allSearch) {
                        queryString += ")";
                    }
                }

                if (allSearch) {
                    queryString += ')';
                }
            } else {
                if (searchType == 'boolean') {
                    queryString += '(' + $(this).find(".queryContent").val() + ')';
                } else {
                    queryString += '("' + $(this).find(".queryContent").val() + '")';
                }
            }

            if (full_queryString != "") {
                full_queryString += " " + queryString;
            } else {
                full_queryString = queryString;
            }

        });

        if (emptyQueryPresent) {
            return false;
        } else {
            $('#query-builder input').val(full_queryString);
            return full_queryString;
        }
    }
