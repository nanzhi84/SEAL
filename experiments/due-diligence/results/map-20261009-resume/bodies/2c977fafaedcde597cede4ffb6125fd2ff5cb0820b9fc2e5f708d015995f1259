                        if ($(advQueries).length == 2 && ($(advQueries[1]).val() != null && $(advQueries[1]).val() != "")) {
                            queryString += '([' + $(advQueries[0]).val() + ' TO ' + $(advQueries[1]).val() + '])';
                        } else {
                            queryString += $(this).find(".queryContent").val();
                        }
                    } else {
                        queryString += $(this).find(".queryContent").val();
                    }

                } else {

                    if (!allSearch) {
                        queryString += "(";
                    }

                    //等于
                    if ($(this).find('.SearchFor').val() == '1') {
                        wrappedTerm = '"' + $(this).find(".queryContent").val() + '"';
                    }//开头是
                    else if ($(this).find('.SearchFor').val() == '2') {
                        wrappedTerm = $(this).find(".queryContent").val() + '*';
                    }//开头不是
                    else if ($(this).find('.SearchFor').val() == '3') {
                        wrappedTerm = $(this).find(".queryContent").val() + '@';
                    }//结尾是
                    else if ($(this).find('.SearchFor').val() == '4') {
                        wrappedTerm = '*' + $(this).find(".queryContent").val();
                    }//结尾不是
                    else if ($(this).find('.SearchFor').val() == '5') {
                        wrappedTerm = '@' + $(this).find(".queryContent").val();
                    }//包含
                    else if ($(this).find('.SearchFor').val() == '6') {
                        wrappedTerm = '*' + $(this).find(".queryContent").val() + '*';
                    }//不包含
                    else if ($(this).find('.SearchFor').val() == '7') {
                        //等于
                        wrappedTerm = '@' + $(this).find(".queryContent").val() + '@';
                    }
                    queryString += wrappedTerm;
                    if (!allSearch) {
                        queryString += ")";
                    }
                }

                if (allSearch) {
                    queryString += ')';
                }
            } else {
                if (searchType == 'boolean') {
                    queryString += '(' + $(this).find(".queryContent").val() + ')';
                } else {
                    queryString += '("' + $(this).find(".queryContent").val() + '")';
                }
            }




            if (full_queryStringChinese != "") {
                full_queryStringChinese += " " + queryString;
            } else {
                full_queryStringChinese = queryString;
            }

        });

        if (emptyQueryPresent) {
            return false;
        } else {
            $('#queryStringChinese').val(full_queryStringChinese);
        }
    }

    //查询条件文本框change事件
    function applyInputListener() {
        $('.advField').off('input change');
        $('#advancedSearch :input').off('input change');
        $('#advancedSearch :input:not(.advField)').on('input change', function (e) {
            if ($(this).hasClass('advField')) {
                e.preventDefault();
            }
            buildQuery();
            buildQueryChinese();
        });
        $('.advField').change(selectChangeListener);
    }

    function selectChangeListener() {

        var selected = $(this).find(":selected");
        var closestQueryInput = $(this).closest('.query-input');

        var inputValue = "";
        if (!closestQueryInput.find(".queryContent").is('select')) {
            inputValue = closestQueryInput.find(".queryContent").val();
        }

        //判断检索类型，对检索条件进行重新构造
        if ($(selected).attr('searchType') == "boolean") {
            if ($(selected).val() == "DEVICE_TYPE") {
                $(closestQueryInput).find('.queryContion_td_For').html('<select tabindex="0" name="SearchContent" class="queryContent"><option value="1">器械</option><option value="2">体外诊断试剂</option></select>');
            } else {
                $(closestQueryInput).find('.queryContion_td_For').html('<select tabindex="0" name="SearchContent" class="queryContent"><option value="1">是</option><option value="0">否</option></select>');
            }
            $(closestQueryInput).find(".queryContion_td_input").html('');
        } else if ($(selected).attr('searchType') == "date") {

            $(closestQueryInput).find('.queryContion_td_For').html(
                '<select tabindex="0" name="SearchFor" class="SearchFor">' +
                '<option value="on">等于</option>' +
                '<option value="before">小于</option>' +
                '<option value="after">大于</option>' +
                '<option value="between">时间段</option>' +
                '</select>');
            $(closestQueryInput).find(".queryContion_td_input").html('<input tabindex="0"  style="width:132px;margin-right: 10px;" maxlength="10" name="SearchContent" class="queryContent startTime" type="text"   placeholder="YYYY-MM-DD" >');
            $(closestQueryInput).find('.queryContion_td_input').find('.startTime').datepicker({
                format: 'yyyy-mm-dd',
                autoclose: true,
                disableDblClickSelection: true
            });

            var thisChangableInput = $(closestQueryInput).find('.queryContion_td_For');

            $(thisChangableInput).off('change select');

            $(thisChangableInput).on('change', 'select', function () {
                if ($(this).val() == 'between') {
                    $(closestQueryInput).find(".queryContion_td_input").append('<input tabindex="0"  style="width: 132px;" maxlength="10" type="text" name="SearchContent" class="queryContent endTime"  placeholder="YYYY-MM-DD" >')
                    $(closestQueryInput).find('.queryContion_td_input').find('.endTime').datepicker({
                        // Watson DE likes dates best in this format
                        format: 'yyyy-mm-dd',
                        autoclose: true,
                        disableDblClickSelection: true
                    });
                    applyInputListener();
                } else {
                    if ($(closestQueryInput).find('.queryContion_td_input').find('.endTime').length > 0) {
                        $(closestQueryInput).find('.queryContion_td_input').find('.endTime').remove();
                    }
                }
            });
        } else {
            if ($(selected).val() == "AGENCY_NAME") {
                $(closestQueryInput).find('.queryContion_td_For').html('<select tabindex="0" name="SearchContent" class="selectLimitedOptions queryContent"><option value="GS1">GS1</option><option value="AHM">AHM</option><option value="MA码（IDcode）">MA码</option></select>');
                $(closestQueryInput).find(".queryContion_td_input").html('');
            } else {
                $(closestQueryInput).find('.queryContion_td_For').html('<select name="SearchFor" class="SearchFor"><option value="1">等于</option><option value="2">开头是</option><option value="3">开头不是</option><option value="4">结尾是</option><option value="5">结尾不是</option><option value="6">包含</option><option value="7">不包含</option></select>');
                $(closestQueryInput).find(".queryContion_td_input").html('<input name="SearchContent" class="queryContent" placeholder="输入查询值"/>');
            }
        }
        buildQuery();
        buildQueryChinese();
        applyInputListener();
    }

    //提交查询
    function submitQuerySearch(event) {

        event.preventDefault();
        //获取已经构建好的查询条件
        var searchQuery = $('#advancedSearch #query-builder input').val();
        $("#searchContntsQuery").val(searchQuery);
        if (searchQuery == null || searchQuery == "") {
            alert("搜索时请选择需要检索的关键字段和检索内容！", "error");
            return false;
        } else {
            $('#advancedSearch').submit();

        }

        return;
    }

    //查询确定按钮
    $("#submitQuerySearch").click(submitQuerySearch)
</script>
