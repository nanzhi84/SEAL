<script type="text/javascript">
    //增加行条件
    var rowHtml = '<tr  class="queryRows query-input"> <th style="width: 80px"><select class="SearchTool" name="SearchTool"><option value="and">与(A）</option><option value="or">或(O)</option></select></th><td><select name="SearchName" class="advField" ><option value="all">请选择</option></select></td><td class="queryContion_td_For"><select name="SearchFor" class="SearchFor"><option value="1">等于</option><option value="2">开头是</option><option value="3">开头不是</option><option value="4">结尾是</option><option value="5">结尾不是</option><option value="6">包含</option><option value="7">不包含</option></select></td><td class="queryContion_td_input"><input name="SearchContent" class="queryContent" placeholder="输入查询值"/></td><td class="control-buttons"><a class="els-delete" onclick="deleteRow(this)"><i class="fa fa-minus-circle" aria-hidden="true"></i></a> </td></tr>';
    var optionsObj = {};
