# 本机环境与工具中间产物，不入库

# Python 虚拟环境与字节码缓存
.venv/
venv/
__pycache__/
*.py[cod]

# 本地凭据与本机覆盖配置
.env
.env.local
*.local.json

# 工具缓存与系统文件
.seiso_cache/
.DS_Store
.vscode/
.idea/
artifacts/
work/
.seal/
# MinIO 服务内部数据，不由 SEAL 直接读写、不入库
/minio/**
!/minio/.gitkeep
*.egg-info/
.ruff_cache/

# 每个实验项目自己的私有工作数据与生成工件
experiments/**/work/
experiments/**/artifacts/

# 用户指定的演示归档与验收工件
playgroud/**/work/
playgroud/**/artifacts/

# Python 安装包，仅在需要打包交付时生成
/dist/
